<% content_for :title, "Edit Zone: #{@zone}" %>

<div class="settings-card">
  <h1>
    <%= link_to t('.locations'), locations_path, class: 'breadcrumb' %>
    <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
    <%= link_to t('.zones'), zones_path, class: 'breadcrumb' %>
    <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
    <%= link_to @zone, zone_path(@zone), class: 'breadcrumb' %>
    <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
    Edit
  </h1>

  <%= render "form", zone: @zone %>

  <p>
    <%= link_to "❌ Discard changes", @zone, class: 'link' %>
  </p>
  <p>
    <%= button_to "🗑️ Destroy this Zone", @zone, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('#{t 'zones.messages.confirm_delete'}');" %>
  </p>
</div>
