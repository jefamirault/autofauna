<%= link_to zone, class: 'resource-card' do %>
  <div class="resource-card-name"><%= zone.name %></div>
  <div class="resource-card-meta">
    <% if zone.hygro_sensor_readings.any? %>
      <%= zone.last_temp %>&deg;F · <%= zone.last_humidity %>% RH ·
    <% end %>
    <%= pluralize(zone.sensors.count, 'sensor') %>
  </div>
<% end %>
