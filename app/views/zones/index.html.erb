<% content_for :title, "Zones" %>

<h1>
  <%= link_to t('.locations'), locations_path, class: 'breadcrumb' %>
  <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
  <%= t '.zones' %>
</h1>

<div class="resource-cards">
  <% @zones.each do |zone| %>
    <%= render zone %>
  <% end %>
</div>

<%= link_to "➕ New Zone", new_zone_path, class: 'link' %>
