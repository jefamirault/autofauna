<% content_for :title, "Group: #{@plant_group}" %>

<h1>
  <%= link_to "Groups", plant_groups_path, class: 'breadcrumb' %>
  <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
  <%= @plant_group %>
</h1>

<div class="info-card">
  <div class="info-card-grid">
    <div class="info-card-section">
      <div class="info-row">
        <span class="label">Name</span>
        <span class="value"><%= @plant_group.name %></span>
      </div>
      <div class="info-row">
        <span class="label">Schedule</span>
        <span class="value"><%= @plant_group.watering_frequency_text.presence || '—' %></span>
      </div>
      <div class="info-row">
        <span class="label">Plants</span>
        <span class="value"><%= @plant_group.plants.count %></span>
      </div>
    </div>
  </div>
</div>

<% if @plant_group.plants.where(archived: false).any? %>
  <%= button_to "💧 Water all plants in this group", water_plant_group_path(@plant_group),
        class: 'link', data: { turbo: false } %>
<% end %>

<div>
  <%= link_to "✏️ Edit this Group", edit_plant_group_path(@plant_group), class: 'link' %>
  <%= link_to "↩️ Back to Groups", plant_groups_path, class: 'link' %>
  <%= button_to "🗑️ Destroy this Group", @plant_group, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('Delete this group? Plants are not deleted.');" %>
</div>
