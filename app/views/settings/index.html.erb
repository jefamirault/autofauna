<% content_for :title, 'Account Settings' %>

<h1>⚙️ <%= t 'layouts.application.account_settings' %></h1>

<div class="settings-card">
  <h2>👤 <%= t 'account.account_information' %></h2>
  <div class="info-row">
    <span class="label">Email:</span>
    <span class="value"><%= current_user.email %></span>
  </div>
  <div class="info-row">
    <span class="label"><%= t 'account.account_type' %>:</span>
    <span class="value">
      <% if current_user.guest? %>
        <%= t 'account.guest_account' %> — <%= link_to t('guest.create_account'), new_guest_conversion_path %>
      <% elsif current_user.google_uid.present? %>
        <%= t 'account.google_account' %>
      <% else %>
        <%= t 'account.email_password_account' %>
      <% end %>
    </span>
  </div>
  <div class="info-row">
    <span class="label"><%= t 'attributes.account_created' %>:</span>
    <span class="value"><%= format_time current_user.created_at %></span>
  </div>
  <div class="info-row">
    <span class="label"><%= t 'attributes.account_updated' %>:</span>
    <span class="value"><%= format_time current_user.updated_at %></span>
  </div>
</div>

<div class="settings-card">
  <h2>🛡️ <%= t 'account.security' %></h2>
  <% unless current_user.guest? || current_user.google_uid.present? %>
    <%= link_to "#{t('account.update_password')}", edit_password_path, class: 'link' %>
    <br><br>
  <% end %>
  <% unless current_user.guest? %>
    <%= button_to "🚪 #{t('layouts.application.log_out')}", session_path, class: 'buttonLink', method: :delete, onclick: "return confirm('#{t 'account.confirm_logout'}');" %>
  <% end %>
</div>

<% unless current_user.guest? %>
  <div class="settings-card">
    <h2>Notifications</h2>
    <%= form_with model: current_user, url: settings_path, method: :patch, local: true do |f| %>
      <div class="field">
        <%= f.label :notification_enabled, "Enable watering reminders" %>
        <%= f.check_box :notification_enabled %>
      </div>
      <div class="field">
        <%= f.label :notification_time, "Preferred notification time" %>
        <%= f.time_field :notification_time, value: current_user.notification_time&.strftime("%H:%M") || "09:00" %>
      </div>
      <div class="submit">
        <%= f.submit "Save notification preferences", class: 'saveButton' %>
      </div>
    <% end %>

    <br>
    <!-- Test Notification Buttons -->
    <h2>Test Notifications</h2>

    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <!-- Test Email Button -->
      <%= button_to send_test_email_path, method: :post, class: "buttonLink", style: "width: 100%; text-align: center;", data: { turbo: false, disable_with: "Sending..." }, disabled: !current_user.plants.any? do %>
        📧 Send Test Email
      <% end %>

      <% unless current_user.plants.any? %>
        <p style="font-size: 0.85em; color: #888; margin: -0.25rem 0 0.5rem 1rem;">Add a plant first to test email notifications</p>
      <% end %>

      <!-- Test Push Notification Button -->
      <%= button_to send_test_push_path, method: :post, class: "buttonLink", style: "width: 100%; text-align: center;", data: { turbo: false, disable_with: "Sending..." }, disabled: !current_user.push_subscriptions.any? do %>
        🔔 Send Test Push Notification
      <% end %>

      <% unless current_user.push_subscriptions.any? %>
        <p style="font-size: 0.85em; color: #888; margin: -0.25rem 0 0 1rem;">Enable push notifications above to test</p>
      <% end %>
    </div>

    <% vapid_public_key = Rails.application.credentials.dig(:web_push, :public_key) %>
    <% if vapid_public_key.present? %>
      <br>
      <h2>Push Notifications</h2>
      <div data-controller="push-notification" data-push-notification-vapid-key-value="<%= vapid_public_key %>">
        <p data-push-notification-target="status"></p>
        <button class="saveButton" data-push-notification-target="subscribeButton" data-action="click->push-notification#subscribe">
          Enable push notifications
        </button>
        <button class="buttonLink" data-push-notification-target="unsubscribeButton" data-action="click->push-notification#unsubscribe" style="display: none;">
          Disable push notifications
        </button>
      </div>
    <% end %>
  </div>
<% end %>

<% unless current_user.guest? || current_user.google_uid.present? %>
  <button class="buttonLinkDanger" onclick="document.getElementById('danger-zone').style.display='block'; this.style.display='none';">🗑️ <%= t 'account.delete_account' %></button>

  <div class="settings-card danger" id="danger-zone" style="display: none;">
    <h2><%= t 'account.danger_zone' %></h2>
    <%= form_with url: settings_path, method: :delete, local: true do |f| %>
      <div class="field">
        <%= f.label :password, t('account.password_required') %>
        <%= f.password_field :password, required: true %>
      </div>
      <div class="submit">
        <%= f.submit "🗑️ #{t('account.delete_account')}", class: 'buttonLinkDanger', onclick: "return confirm('#{j t('account.confirm_delete_account')}');" %>
      </div>
    <% end %>
  </div>
<% end %>
