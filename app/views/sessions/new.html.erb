<div class="settings-card auth-card">
  <h2><%= t 'log_in' %></h2>

  <%= form_with model: @user || User.new, url: session_path do |form| %>
    <div class="field">
      <%= form.label :email, t('email') %>
      <%= form.email_field :email, autofocus: true %>
    </div>

    <div class="field">
      <%= form.label :password, t('password') %>
      <%= form.password_field :password %>
    </div>

    <div class="submit">
      <%= form.submit t('log_in'), class: 'saveButton' %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= link_to t('sign_up'), new_registration_path, class: 'link' %>
    <%= link_to t('forgot_password'), new_password_reset_path, class: 'link' %>
  </div>
</div>
