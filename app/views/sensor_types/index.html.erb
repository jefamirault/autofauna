<% content_for :title, "Sensor Types" %>

<h1>
  <%= link_to t('.sensors'), sensors_path, class: 'breadcrumb' %>
  <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
  <%= t '.sensor_types' %>
</h1>

<div class="resource-cards">
  <% @sensor_types.each do |sensor_type| %>
    <%= render sensor_type %>
  <% end %>
</div>

<%= link_to "➕ New Sensor Type", new_sensor_type_path, class: 'link' %>
