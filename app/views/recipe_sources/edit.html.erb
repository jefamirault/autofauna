<% content_for :title, "Edit Source: #{@recipe_source}" %>

<div class="settings-card">
  <h1>
    <%= link_to "Sources", recipe_sources_path, class: 'breadcrumb' %>
    <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
    <%= link_to @recipe_source, recipe_source_path(@recipe_source), class: 'breadcrumb' %>
    <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
    Edit
  </h1>

  <%= render "form", recipe_source: @recipe_source %>

  <p>
    <%= link_to "❌ Discard changes", @recipe_source, class: 'link' %>
  </p>
  <p>
    <%= button_to "🗑️ Destroy this source", @recipe_source, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('Are you sure you want to permanently delete this Source?');" %>
  </p>
</div>
