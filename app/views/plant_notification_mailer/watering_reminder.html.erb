<h2>Your plants need watering!</h2>

<p>Hi <%= @user.email %>,</p>

<p>The following plants are due for watering:</p>

<ul>
  <% @plants.each do |plant| %>
    <li>
      <a href="<%= plant_url(plant) %>"><%= plant.label %></a>
      <% if plant.date_last_watering %>
        — last watered <%= plant.date_last_watering.strftime("%b %d") %>
      <% end %>
    </li>
  <% end %>
</ul>

<p><a href="<%= root_url %>">Open Autofauna</a></p>
