<% content_for :title, "Water Tests" %>

<h1>Water Tests</h1>
<p>Test history for <%= @tank.name %></p>

<div>
  <%= link_to "↩️ Back to Tank", tank_path(@tank), class: 'link' %>
  <%= link_to "🧪 New Test", new_tank_water_test_path(@tank), class: 'link' %>
</div>

<% if @water_tests.any? %>
  <%= render 'water_tests', water_tests: @water_tests %>
<% else %>
  <p>No water tests yet. Get started by recording your first water test.</p>
  <%= link_to "🧪 Record First Test", new_tank_water_test_path(@tank), class: 'link' %>
<% end %>
