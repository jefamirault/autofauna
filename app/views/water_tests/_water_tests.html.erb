<table id="water_tests">
  <thead>
  <tr>
    <th>Date</th>
    <th>TDS</th>
    <th>pH</th>
    <th>Temp</th>
    <th>NH₃</th>
    <th>NO₂</th>
    <th>NO₃</th>
    <th>Actions</th>
  </tr>
  </thead>
  <tbody>
  <% water_tests.each do |test| %>
    <tr>
      <td>
        <%= time_or_date test.tested_at %>
      </td>
      <td>
        <%= test.tds || "—" %>
      </td>
      <td>
        <% if test.ph %>
          <%= test.ph.round(1) %>
        <% else %>
          —
        <% end %>
      </td>
      <td>
        <%= test.temperature ? "#{test.temperature.round(1)}°#{test.temperature_unit}" : "—" %>
      </td>
      <td>
        <% if test.ammonia %>
          <%= test.ammonia.round(2) %>
        <% else %>
          —
        <% end %>
      </td>
      <td>
        <% if test.nitrite %>
          <%= test.nitrite.round(2) %>
        <% else %>
          —
        <% end %>
      </td>
      <td>
        <%= test.nitrate ? test.nitrate.round(1) : "—" %>
      </td>
      <td>
        <%= link_to "✏️", edit_tank_water_test_path(@tank, test), class: "link" %>
        <%= button_to "🗑️", tank_water_test_path(@tank, test), method: :delete,
                      class: "buttonLinkDanger",
                      onclick: "return confirm('Are you sure you want to permanently delete this Water Test?');" %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
