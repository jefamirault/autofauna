<div class="formContainer">
  <%= form_with(model: watering, data: { controller: "watering-recipe watering-moisture", watering_recipe_url_value: for_recipe_recipe_batches_path, turbo: false }) do |form| %>
    <% if watering.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(watering.errors.count, "error") %> prohibited this watering from being saved:</h2>

        <ul>
          <% watering.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.label :plant, style: "display: block" %>
    <div class="plantButton">
      <%= link_to watering.plant %>
      <%= form.hidden_field :plant_id, value: watering.plant&.id %>
    </div>

    <div>
      <%= form.label :watered_at, "Date & Time", style: "display: block" %>
      <%= form.datetime_local_field :watered_at,
          value: watering.watered_at&.strftime("%Y-%m-%dT%H:%M") ||
                 Time.zone.now.strftime("%Y-%m-%dT%H:%M") %>
    </div>

    <div>
      <%= form.label :volume, style: "display: block" %>
      <%= form.number_field :volume, step: 'any', placeholder: "e.g. 2.0" %>
    </div>

    <div>
      <%= form.label :units, t('attributes.units'), style: "display: block" %>
      <%= form.select :units, options_for_select(Watering.units.map {|k,v| [k, k]}, watering.units || watering.plant.suggested_watering_unit) %>
    </div>

    <% if current_project.recipes.any? %>
      <div>
        <%= form.label :recipe_id, "Recipe", style: "display: block" %>
        <%= form.collection_select :recipe_id, current_project.recipes.order(:name), :id, :name, { prompt: '-- None --', selected: watering.recipe_id }, { data: { watering_recipe_target: "recipeSelect", action: "change->watering-recipe#recipeChanged" } } %>
      </div>

      <div>
        <%= form.label :recipe_batch_id, "Batch", style: "display: block" %>
        <select name="watering[recipe_batch_id]" id="watering_recipe_batch_id" data-watering-recipe-target="batchSelect" data-action="change->watering-recipe#batchChanged">
          <option value="">-- None --</option>
          <% if watering.recipe_id.present? %>
            <% current_project.recipe_batches.active.where(recipe_id: watering.recipe_id).each do |batch| %>
              <option value="<%= batch.id %>" data-tds="<%= batch.tds %>" <%= 'selected' if watering.recipe_batch_id == batch.id %>><%= batch.label %></option>
            <% end %>
          <% end %>
        </select>
      </div>

      <div>
        <%= form.label :tds, "TDS (ppm)", style: "display: block" %>
        <%= form.number_field :tds, placeholder: "e.g. 400", data: { watering_recipe_target: "tdsField" } %>
      </div>
    <% end %>

    <div>
      <%= form.label :notes, style: "display: block" %>
      <%= form.text_area :notes, autofocus: watering.notes.nil? || watering.notes == '', placeholder: "e.g. Tap water" %>
    </div>

    <div class="moisture-section">
      <div class="moisture-header">
        <button type="button"
                data-action="click->watering-moisture#togglePre"
                data-watering-moisture-target="preButton"
                class="buttonLink"
                style="<%= 'display: none;' if @recent_moisture_reading %>">
          ➕ Add Pre-Watering Moisture
        </button>
        <button type="button"
                data-action="click->watering-moisture#togglePost"
                data-watering-moisture-target="postButton"
                class="buttonLink">
          ➕ Add Post-Watering Moisture
        </button>
      </div>

      <!-- Pre-moisture field (auto-shown if recent reading exists) -->
      <div data-watering-moisture-target="preField" style="<%= @recent_moisture_reading ? 'display: block;' : 'display: none;' %>">
        <%= form.label :pre_moisture, "Pre-Watering Moisture", style: "display: block" %>
        <% if @recent_moisture_reading %>
          <small style="display: block; margin-bottom: 0.5rem; color: #666;">
            ✨ Auto-filled from reading <%= time_ago_in_words(@recent_moisture_reading.measured_at) %> ago
          </small>
          <%= form.hidden_field :pre_moisture_reading_id, value: @recent_moisture_reading.id %>
        <% end %>
        <% if current_project.moisture_measurement_type == 'numeric' %>
          <%= form.number_field :pre_moisture,
              value: @recent_moisture_reading&.value_numeric,
              step: '0.1', placeholder: "e.g. 45.5" %>
          <small>Numeric value</small>
        <% else %>
          <%= form.select :pre_moisture,
              options_for_select(
                SoilMoistureReading.value_categoricals.keys.map { |k| [k.titleize, k] },
                @recent_moisture_reading&.value_categorical
              ),
              { prompt: '-- Select --' } %>
        <% end %>
        <button type="button"
                data-action="click->watering-moisture#hidePre"
                class="buttonLinkSmall">✕ Remove</button>
      </div>

      <!-- Post-moisture field (hidden by default) -->
      <div data-watering-moisture-target="postField" style="display: none;">
        <%= form.label :post_moisture, "Post-Watering Moisture", style: "display: block" %>
        <% if current_project.moisture_measurement_type == 'numeric' %>
          <%= form.number_field :post_moisture,
              step: '0.1', placeholder: "e.g. 85.0" %>
          <small>Numeric value</small>
        <% else %>
          <%= form.select :post_moisture,
              options_for_select(
                SoilMoistureReading.value_categoricals.keys.map { |k| [k.titleize, k] }
              ),
              { prompt: '-- Select --' } %>
        <% end %>
        <button type="button"
                data-action="click->watering-moisture#hidePost"
                class="buttonLinkSmall">✕ Remove</button>
      </div>
    </div>

    <br>
    <div>
      <% submit_text = t(watering.new_record? ? 'waterings.create_watering' : 'waterings.update_watering') %>
      <%= form.submit submit_text, class: 'saveButton' %>
    </div>
  <% end %>
</div>
