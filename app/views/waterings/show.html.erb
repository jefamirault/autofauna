<% content_for :title do %>
  Watered #<%= @watering.plant.uid %> <%= @watering.plant.name %> <%= @watering.watered_at.strftime '%a %-m/%-d/%y %l:%M%P' %>
<% end %>

<% if @watering.plant&.has_graphic? %>
  <% content_for :header_extra do %>
    <div class="header-plant-graphic">
      <%= image_tag @watering.plant.display_graphic, class: 'plant-graphic-image' %>
      <div class="header-plant-name">
        <span class="plant-number">#<%= @watering.plant.uid %></span>
        <span class="plant-name-text"><%= @watering.plant.name %></span>
      </div>
    </div>
  <% end %>
<% end %>

<%= render @watering %>
