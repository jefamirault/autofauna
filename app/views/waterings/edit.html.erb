<% content_for :title, "Edit Watering #{@watering.plant}" %>

<% if @watering.plant&.graphic_path %>
  <% content_for :header_extra do %>
    <div class="header-plant-graphic">
      <%= image_tag @watering.plant.graphic_path, class: 'plant-graphic-image' %>
    </div>
  <% end %>
<% end %>

<div class="settings-card">
  <h2><%= t('waterings.edit_watering') %></h2>
  <%= render "form", watering: @watering %>

  <p>
    <%= link_to "❌ #{t('actions.discard_changes')}", @watering, class: 'link' %>
  </p>
  <p>
    <%= button_to "🗑️ #{t('waterings.delete_watering')}", @watering, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('#{t 'waterings.messages.confirm_delete'}');" %>
  </p>
</div>
