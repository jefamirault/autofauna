<% content_for :title, "Edit Watering #{@watering.plant}" %>

<% if @watering.plant&.has_graphic? %>
  <% content_for :header_extra do %>
    <div class="header-plant-graphic">
      <%= image_tag @watering.plant.display_graphic, class: 'plant-graphic-image' %>
      <div class="header-plant-name">
        <span class="plant-number">#<%= @watering.plant.uid %></span>
        <span class="plant-name-text"><%= @watering.plant.name %></span>
      </div>
    </div>
  <% end %>
<% end %>

<div class="settings-card">
  <div class="card-title-row">
    <h2><%= t('waterings.edit_watering') %></h2>
    <% if @watering.plant %>
      <div class="plantButton"><%= link_to @watering.plant %></div>
    <% end %>
  </div>
  <%= render "form", watering: @watering %>

  <div class="card-footer-actions">
    <%= link_to "❌ #{t('actions.discard_changes')}", @watering, class: 'link' %>
    <%= button_to "🗑️ #{t('waterings.delete_watering')}", @watering, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('#{t 'waterings.messages.confirm_delete'}');" %>
  </div>
</div>
