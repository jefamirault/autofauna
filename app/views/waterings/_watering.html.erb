<div id="<%= dom_id watering %>" class="settings-card">
  <h2><%= t('waterings.watered_on') %> <%= format_date watering.watered_at, long: true %></h2>
  <small><%= time_ago watering.watered_at %></small>

  <div class="info-row">
    <strong><%= t 'attributes.plant' %></strong>
    <div class="plantButton">
      <%= link_to watering.plant %>
    </div>
  </div>

  <% if feature_enabled?(:precise_measurements) && watering.volume.present? %>
    <div class="info-row">
      <strong><%= t 'attributes.volume' %></strong>
      <span class="value"><%= watering.print_volume %></span>
    </div>
  <% end %>

  <% if feature_enabled?(:use_fertilizers) %>
  <% if watering.recipe_source.present? %>
    <div class="info-row">
      <strong>Source</strong>
      <span class="value"><%= link_to watering.recipe_source.name, recipe_source_path(watering.recipe_source) %></span>
    </div>
  <% end %>

  <% if watering.recipe.present? %>
    <div class="info-row">
      <strong>Recipe</strong>
      <span class="value"><%= link_to watering.recipe.name, recipe_path(watering.recipe), class: 'link' %></span>
    </div>
  <% end %>

  <% if watering.recipe_batch.present? %>
    <div class="info-row">
      <strong>Batch</strong>
      <span class="value"><%= link_to watering.recipe_batch.label, recipe_batch_path(watering.recipe_batch) %></span>
    </div>
  <% end %>
  <% end %>

  <% if feature_enabled?(:precise_measurements) && watering.tds.present? %>
    <div class="info-row">
      <strong>TDS (ppm)</strong>
      <span class="value"><%= watering.tds %></span>
    </div>
  <% end %>

  <% if watering.notes.present? %>
    <div class="info-row">
      <strong><%= t 'attributes.notes' %></strong>
      <span class="value"><%= watering.notes.gsub("\n",'<br>').html_safe %></span>
    </div>
  <% end %>

  <% if feature_enabled?(:track_soil_moisture) %>
  <% pre = watering.soil_moisture_readings.find_by(timing: :pre_watering) %>
  <% post = watering.soil_moisture_readings.find_by(timing: :post_watering) %>
  <% if pre || post %>
    <% if pre %>
      <div class="info-row">
        <strong>Pre-Watering Moisture</strong>
        <span class="value"><%= pre.display_value %></span>
      </div>
    <% end %>
    <% if post %>
      <div class="info-row">
        <strong>Post-Watering Moisture</strong>
        <span class="value"><%= post.display_value %></span>
      </div>
    <% end %>
  <% end %>
  <% end %>

  <div class="info-row">
    <strong><%= t 'attributes.logged' %></strong>
    <span class="value"><%= format_time watering.created_at %></span>
  </div>

  <p>
    <%= link_to t('waterings.edit_watering'), edit_watering_path(watering), class: 'link' %>
    <%= link_to t('waterings.all_waterings'), waterings_path, class: 'link' %>
    <%= link_to t('waterings.water_again'), plant_water_path(watering.plant, volume: watering.volume, units: watering.units, notes: watering.notes, recipe_id: watering.recipe_id, recipe_batch_id: watering.recipe_batch_id, tds: watering.tds), class: 'link' %>
  </p>
</div>
