<div class="settings-card">
  <div class="card-title-row">
    <h2>🌱 <%= t('soil_moisture_readings.edit') %></h2>
    <div class="plantButton"><%= link_to @plant %></div>
  </div>

  <%= render 'form', soil_moisture_reading: @soil_moisture_reading %>

  <div class="card-footer-actions">
    <%= link_to "❌ #{t('actions.cancel')}", plant_path(@plant), class: 'link' %>
    <%= button_to "🗑️ #{t('soil_moisture_readings.delete')}",
        plant_soil_moisture_reading_path(@plant, @soil_moisture_reading),
        method: :delete,
        class: 'buttonLinkDanger',
        onclick: "return confirm('#{t 'soil_moisture_readings.confirm_delete'}');" %>
  </div>
</div>
