<%= form_with(model: location, data: { turbo: false }) do |form| %>
  <% if location.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(location.errors.count, "error") %> prohibited this location from being saved:</h2>

      <ul>
        <% location.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :project_id, value: location&.project_id || current_project.id %>

  <% unless current_project.zones.empty? %>
    <div>
      <%= form.label :zone_id, style: "display: block" %>
      <%= form.select :zone_id, options_from_collection_for_select(current_project.zones, :id, :name, location&.zone&.id), prompt: '-- Select Zone --' %>
    </div>
  <% end %>
  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name, placeholder: "e.g. Living Room 📺" %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description, placeholder: "e.g. South facing windows" %>
  </div>

  <div>
    <%= form.label :color, "Color", style: "display: block" %>
    <%= form.color_field :color, value: location.hex_color %>
    <small>Used for filter buttons and group headers</small>
  </div>

  <div data-controller="image-upload">
    <%= form.label :picture, "Photo", style: "display: block" %>
    <div class="graphic-upload-container">
      <%= hidden_field_tag "location[remove_picture]", "0", data: { image_upload_target: "removeFlag" } %>
      <% if location.picture_attached? %>
        <%= image_tag location.picture.variant(resize_to_limit: [300, 300]), alt: "Current photo", class: "plant-graphic-preview-image", data: { image_upload_target: "currentImage" } %>
      <% end %>
      <%= form.file_field :picture,
        accept: Location::ACCEPTED_PICTURE_TYPES.join(","),
        class: "graphic-file-input",
        data: {
          image_upload_target: "fileInput",
          action: "change->image-upload#filePreview"
        }
      %>
      <div class="graphic-upload-buttons">
        <button type="button" class="graphic-upload-btn"
                data-action="image-upload#chooseFile">📁 Choose a photo</button>
        <button type="button" class="graphic-upload-btn"
                data-image-upload-target="cameraButton"
                data-action="image-upload#takePhoto">📷 Take a photo</button>
        <% if location.picture_attached? %>
          <button type="button" class="graphic-upload-btn"
                  data-image-upload-target="removeButton"
                  data-action="image-upload#remove">✕ Remove photo</button>
        <% end %>
      </div>
      <%= image_tag "", alt: "Upload preview", class: "plant-graphic-preview-image", data: { image_upload_target: "preview" }, style: "display: none;" %>
      <small>PNG, JPEG, WEBP, or GIF — up to 20MB.</small>
    </div>
  </div>

  <div>
    <%= form.submit "💾 #{location.new_record? ? 'Create' : 'Update'} Location", class: 'saveButton' %>
  </div>
<% end %>
