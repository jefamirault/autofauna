<% content_for :title, "Locations" %>

<h1>Locations</h1>

<% unless @locations.empty? %>
  <%= link_to "🗺️ View Zones", zones_path, class: 'link' %>
<% end %>

<div class="resource-cards">
  <% @locations.each do |location| %>
    <%= render location %>
  <% end %>
</div>

<%= link_to "➕ New Location", new_location_path, class: 'link' %>
