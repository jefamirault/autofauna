<% content_for :title, "New location" %>

<div class="settings-card">
  <h1>
    <%= link_to t('.locations'), locations_path, class: 'breadcrumb' %>
    <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
    <%= t 'locations.index.new_location' %>
  </h1>

  <%= render "form", location: @location %>

  <p>
    <%= link_to "❌ Cancel", locations_path, class: 'link' %>
  </p>
</div>
