<% content_for :title, "Location: #{@location}" %>

<h1>
  <%= link_to t('.locations'), locations_path, class: 'breadcrumb' %>
  <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
  <%= @location %>
</h1>

<% if @location.picture_attached? %>
  <div class="location-photo" data-controller="image-lightbox"
       data-image-lightbox-src-value="<%= url_for(@location.picture.variant(resize_to_limit: [1600, 1600])) %>">
    <%= image_tag @location.picture.variant(Location::PICTURE_VARIANT), alt: @location.name, class: 'location-photo-image',
                  role: 'button', tabindex: 0, title: 'View fullscreen',
                  data: { action: 'click->image-lightbox#open' } %>
  </div>
<% end %>

<div class="info-card">
  <div class="info-card-grid">
    <div class="info-card-section">
      <div class="info-row">
        <span class="label">Name</span>
        <span class="value"><%= @location.name %></span>
      </div>
      <div class="info-row">
        <span class="label">Zone</span>
        <span class="value"><%= @location.zone || '—' %></span>
      </div>
      <% if @location.description.present? %>
        <div class="info-row">
          <span class="label">Description</span>
          <span class="value"><%= @location.description %></span>
        </div>
      <% end %>
      <div class="info-row">
        <span class="label">Plants</span>
        <span class="value"><%= @location.plants.count %></span>
      </div>
    </div>
  </div>
</div>

<% if @location.plants.where(archived: false).any? %>
  <%= button_to "💧 Water all plants here", water_all_location_path(@location), class: 'link', data: { turbo: false } %>
  <%= button_to "➕ Create a group from these plants", seed_from_location_plant_groups_path(location_id: @location.id), class: 'link', data: { turbo: false } %>
<% end %>

<div>
  <%= link_to "✏️ Edit this Location", edit_location_path(@location), class: 'link' %>
  <%= link_to "↩️ Back to Locations", locations_path, class: 'link' %>

  <%= button_to "🗑️ Destroy this Location", @location, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('#{t 'locations.messages.confirm_delete'}');" %>
</div>
