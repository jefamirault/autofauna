<% content_for :title, "Location: #{@location}" %>

<h1>
  <%= link_to t('.locations'), locations_path, class: 'breadcrumb' %>
  <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
  <%= @location %>
</h1>

<% if @location.picture_attached? %>
  <div class="location-photo" data-controller="image-lightbox"
       data-image-lightbox-src-value="<%= url_for(@location.picture.variant(resize_to_limit: [1600, 1600])) %>">
    <%= image_tag @location.picture.variant(Location::PICTURE_VARIANT), alt: @location.name, class: 'location-photo-image',
                  role: 'button', tabindex: 0, title: 'View fullscreen',
                  data: { action: 'click->image-lightbox#open' } %>
  </div>
<% end %>

<div class="info-card">
  <div class="info-card-grid">
    <div class="info-card-section">
      <div class="info-row">
        <span class="label">Name</span>
        <span class="value"><%= @location.name %></span>
      </div>
      <div class="info-row">
        <span class="label">Zone</span>
        <span class="value"><%= @location.zone || '—' %></span>
      </div>
      <% if @location.description.present? %>
        <div class="info-row">
          <span class="label">Description</span>
          <span class="value"><%= @location.description %></span>
        </div>
      <% end %>
      <div class="info-row">
        <span class="label">Plants</span>
        <span class="value"><%= @location.plants.count %></span>
      </div>
    </div>
  </div>
</div>

<% if feature_enabled?(:use_fertilizers) %>
  <div class="settings-card" id="location-supplies">
    <h2>Supplies</h2>
    <p class="supply-intro">Water &amp; fertilizer stocked here. Tracked separately from each batch's own remaining volume.</p>

    <% if @location_supplies.any? %>
      <div class="supply-list">
        <% @location_supplies.each do |supply| %>
          <%= render "location_supplies/supply", supply: supply, location: @location %>
        <% end %>
      </div>
    <% else %>
      <p class="supply-empty">No supplies stocked here yet.</p>
    <% end %>

    <% if @available_sources.any? || @available_batches.any? %>
      <div class="form-section-label">Stock a supply</div>
      <%= form_with url: location_location_supplies_path(@location), method: :post, data: { turbo: false } do %>
        <div class="field">
          <%= select_tag :supplyable,
                grouped_options_for_select([
                  ["Sources", @available_sources.map { |s| [s.name, "RecipeSource:#{s.id}"] }],
                  ["Batches", @available_batches.map { |b| [b.label, "RecipeBatch:#{b.id}"] }]
                ]),
                include_blank: "Choose a source or batch…" %>
        </div>
        <div class="field-row">
          <div class="field-row-item">
            <%= number_field_tag :amount, nil, step: 'any', min: 0, placeholder: "Amount" %>
          </div>
          <div class="field-row-item">
            <%= select_tag :units, options_for_select(LocationSupply.quantity_units.keys.map { |k| [k, k] }, "gal") %>
          </div>
        </div>
        <div class="submit">
          <%= submit_tag "Add to supply", class: 'saveButton' %>
        </div>
      <% end %>
    <% else %>
      <p class="supply-empty">Create a source or batch first to stock supply here.</p>
    <% end %>
  </div>
<% end %>

<% if @location.plants.where(archived: false).any? %>
  <%= button_to "💧 Water all plants here", water_all_location_path(@location), class: 'link', data: { turbo: false } %>
  <%= button_to "➕ Create a group from these plants", seed_from_location_plant_groups_path(location_id: @location.id), class: 'link', data: { turbo: false } %>
<% end %>

<div>
  <%= link_to "✏️ Edit this Location", edit_location_path(@location), class: 'link' %>
  <%= link_to "↩️ Back to Locations", locations_path, class: 'link' %>

  <%= button_to "🗑️ Destroy this Location", @location, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('#{t 'locations.messages.confirm_delete'}');" %>
</div>
