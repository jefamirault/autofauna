<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= yield(:title).empty? ? "#{params[:controller].titleize} - #{params[:action].titleize}" : yield(:title) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <script>
      // Apply sidebar state before render to prevent FOUC
      (function() {
        try {
          var stored = localStorage.getItem('sidebar-minimized');
          var isMobile = window.innerWidth < 600;
          var shouldMinimize = isMobile || (stored ? JSON.parse(stored) : false);
          if (shouldMinimize) {
            document.documentElement.classList.add('sidebarMinimized');
          }
          // Disable transitions until JS loads
          document.documentElement.classList.add('no-transition');
        } catch (e) {}
      })();
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= favicon_link_tag 'autofauna_icon', type: 'image/png' %>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#004D40">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://accounts.google.com/gsi/client" async defer onload="window.googleLoaded=true; window.dispatchEvent(new Event('google-loaded'))"></script>
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/service-worker.js');
      }
    </script>
  </head>

  <body class="<%= Rails.env %> contents" data-controller="sidebar"
        data-sidebar-minimized-class="sidebarMinimized">

    <% config = header_config %>
    <header class="<%= config[:gradient_class] %>">
      <%= yield :header_extra %>
      <% if user_signed_in? %>
        <div id="headerRight" data-controller="dropdown">
          <div id="headerTitle"><%= config[:title] %></div>
          <div id="headerEmail" data-action="click->dropdown#toggle">
            <span class="email-text"><%= current_user.guest? ? t('guest.guest') : current_user.email %></span>
            <span class="mobile-user-icon">&#128100;</span>
          </div>
          <div class="header-dropdown hidden" data-dropdown-target="menu">
            <% if current_user.admin? %>
              <%= link_to "#{t('.users')}", users_path, class: 'dropdown-item' %>
              <%= link_to "🔔 Notifications", admin_notifications_path, class: 'dropdown-item' %>
            <% end %>
            <% if current_project && show_project_ui? %>
              <%= link_to "#{t('.project_settings')}", project_path(current_project), class: 'dropdown-item' %>
            <% end %>
            <%= link_to "#{t('.account_settings')}", settings_path, class: 'dropdown-item' %>
            <% unless current_user.guest? %>
              <%= button_to t('.log_out'), session_path, method: :delete, class: 'dropdown-logout', onclick: "return confirm('#{t 'account.confirm_logout'}');" %>
            <% end %>
          </div>
        </div>
      <% end %>

    </header>

    <aside id="sidebar">
      <button data-sidebar-target="toggleButton"
              data-action="click->sidebar#toggle"
              class="collapseSidebar"
              aria-label="Collapse sidebar">
        <div id="logoContainer">
          <%= image_tag config[:icon] %>
          <div id="logoText"><%= config[:title] %></div>
        </div>
      </button>
      <nav data-action="click->sidebar#handleNavClick">
        <%= nav_link 'plants', action: 'index', text: "🌱 #{t('.plants')}" %>
        <% if params[:controller] == 'plants' %>
          <div class="indent">
            <%= nav_link 'plants', action: 'new', text: "✏️ #{t('.new_plant')}", path: new_plant_path %>
            <%= nav_link 'plants', action: 'archive', text: "🗃️ #{t('.archive')}", path: plants_archive_path %>
          </div>
        <% end %>
        <%= nav_link 'waterings', action: 'index', text: "💧 Water" %>
        <% if params[:controller].in?(%w[waterings recipes recipe_batches recipe_sources]) %>
          <div class="indent">
            <%= nav_link 'recipes', text: "🧪 Recipes" %>
            <%= nav_link 'recipe_batches', text: "🪣 Batches" %>
            <%= nav_link 'recipe_sources', text: "📦 Sources" %>
          </div>
        <% end %>
        <%= nav_link 'tanks', text: "🐟 #{t('.tanks')}" %>
        <%= nav_link 'locations', text: "📍 #{t('.locations')}" %>
        <% if params[:controller] == 'locations' || params[:controller] == 'zones' %>
          <div class="indent">
            <%= nav_link 'zones', text: "🌎 #{t('.zones')}" %>
          </div>
        <% end %>
        <% if current_user&.advanced_mode? %>
          <%= nav_link 'sensors', text: "📡 #{t('.sensors')}" %>
          <% if params[:controller] == 'sensors' || params[:controller] == 'sensor_readings' || params[:controller] == 'sensor_types' %>
            <div class="indent">
              <%= nav_link 'sensor_readings', action: 'readings', text: "📊 #{t('.sensor_readings')}", path: sensor_readings_path %>
              <%= nav_link 'sensor_types', text: "🏷️ #{t('.sensor_types')}" %>
            </div>
          <% end %>
        <% end %>
        <div class="fill"></div>
        <div id="sidebarLocale" data-controller="locale-popup" data-locale-popup-flag-value="<%= current_locale == 'es' ? '🇲🇽' : '🇺🇸' %>">
          <div class="locale-options hidden" data-locale-popup-target="menu">
            <% if current_locale != 'en' %>
              <%= link_to raw('🇺🇸 <span class="nav-label">English</span>'), "?locale=en", class: "navItem locale-option" %>
            <% end %>
            <% if current_locale != 'es' %>
              <%= link_to raw('🇲🇽 <span class="nav-label">Español</span>'), "?locale=es", class: "navItem locale-option" %>
            <% end %>
          </div>
          <button class="locale-toggle-btn navItem" data-action="click->locale-popup#toggle" aria-label="Change language">
            <span data-locale-popup-target="icon">🌐</span> <span class="nav-label"><%= current_locale == 'es' ? 'Español' : 'English' %></span>
          </button>
        </div>
        <% unless user_signed_in? %>
          <%= link_to t('log_in'), new_session_path, class: 'navItem' %>
        <% end %>
      </nav>
    </aside>

    <main class="<%= params[:controller] %> <%= params[:action] %>">
      <%= render 'layouts/flash' %>

      <% if current_user&.guest? %>
        <div class="guest-banner">
          <%= t('guest.banner_message') %>
          <%= link_to t('guest.create_account'), new_guest_conversion_path, class: 'guest-banner-link' %>
        </div>
      <% end %>

      <section id="primary">
        <%= yield %>
      </section>

    </main>

  </body>
</html>
