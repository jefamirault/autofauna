<% content_for :title, 'Weather' %>

<h1>Weather</h1>

<div class="settings-card" data-controller="weather-location">
  <h2>Location</h2>

  <%= form_with url: weather_lookup_path, method: :post, local: true do |f| %>
    <div class="field">
      <%= f.label :zip, "Zip Code" %>
      <div style="display: flex; gap: 0.5rem; align-items: flex-start;">
        <%= f.text_field :zip, value: @zip, placeholder: "e.g. 10001", maxlength: 10, style: "flex: 1;" %>
        <%= f.submit "Look Up", class: "saveButton" %>
      </div>
    </div>
  <% end %>

  <div style="margin-top: 0.75rem;">
    <button type="button" class="buttonLink" style="width: 100%; text-align: center;"
            data-action="click->weather-location#detectLocation"
            data-weather-location-target="detectButton">
      Use My Location
    </button>
    <p data-weather-location-target="status" style="font-size: 0.85em; color: #888; margin: 0.25rem 0 0 0; display: none;"></p>
  </div>
</div>

<% if @weather %>
  <div class="info-card">
    <div class="info-card-grid" style="grid-template-columns: 1fr;">
      <div class="info-card-section">
        <h3 style="margin: 0 0 0.5rem 0; font-weight: 500; opacity: 0.7;">
          <%= @weather[:current][:emoji] %> <%= @weather[:current][:description] %> in <%= @weather[:location_name] || "your area" %>
        </h3>
        <div class="info-row primary">
          <span class="label">Temperature</span>
          <span class="value"><%= @weather[:current][:temperature].round %>&deg;F</span>
        </div>
        <div class="info-row">
          <span class="label">Feels Like</span>
          <span class="value"><%= @weather[:current][:feels_like].round %>&deg;F</span>
        </div>
        <div class="info-row">
          <span class="label">Humidity</span>
          <span class="value"><%= @weather[:current][:humidity] %>%</span>
        </div>
        <div class="info-row">
          <span class="label">Precipitation</span>
          <span class="value"><%= @weather[:current][:precipitation] %> in</span>
        </div>
        <div class="info-row">
          <span class="label">Wind</span>
          <span class="value"><%= @weather[:current][:wind_speed].round %> mph</span>
        </div>
        <div class="info-row">
          <span class="label">UV Index</span>
          <span class="value"><%= @weather[:current][:uv_index].round %></span>
        </div>
      </div>

      <div class="info-card-section">
        <h3 style="margin: 0 0 0.5rem 0; font-weight: 500; opacity: 0.7;">7-Day Forecast</h3>
        <% @weather[:daily].each do |day| %>
          <div class="info-row">
            <span class="label"><%= day[:date].strftime('%a %-m/%-d') %></span>
            <span class="value">
              <%= day[:emoji] %>
              <%= day[:high].round %>&deg; / <%= day[:low].round %>&deg;
              <% if day[:precipitation_probability] > 0 %>
                <span style="color: #1565C0; margin-left: 0.5rem;"><%= day[:precipitation_probability] %>%</span>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
