<%= form_with(model: tank, data: { turbo: false }) do |form| %>
  <% if tank.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(tank.errors.count, "error") %> prohibited this tank from being saved:</h2>

      <ul>
        <% tank.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :project_id, value: tank&.project_id || current_project.id %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :capacity, style: "display: block" %>
    <%= form.number_field :capacity, step: 'any' %>
  </div>

  <div>
    <%= form.label :capacity_units, 'Units', style: "display: block" %>
    <%= form.select :capacity_units, options_for_select(Tank.capacity_units.map {|k,v| [k, k]}, tank.capacity_units) %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div data-controller="image-upload">
    <%= form.label :picture, "Photo", style: "display: block" %>
    <div class="graphic-upload-container">
      <%= hidden_field_tag "tank[remove_picture]", "0", data: { image_upload_target: "removeFlag" } %>
      <% if tank.picture_attached? %>
        <%= image_tag tank.picture.variant(resize_to_limit: [300, 300]), alt: "Current photo", class: "plant-graphic-preview-image", data: { image_upload_target: "currentImage" } %>
      <% end %>
      <%= form.file_field :picture,
        accept: Tank::ACCEPTED_PICTURE_TYPES.join(","),
        class: "graphic-file-input",
        data: {
          image_upload_target: "fileInput",
          action: "change->image-upload#filePreview"
        }
      %>
      <div class="graphic-upload-buttons">
        <button type="button" class="graphic-upload-btn"
                data-action="image-upload#chooseFile">📁 Choose a photo</button>
        <button type="button" class="graphic-upload-btn"
                data-image-upload-target="cameraButton"
                data-action="image-upload#takePhoto">📷 Take a photo</button>
        <% if tank.picture_attached? %>
          <button type="button" class="graphic-upload-btn"
                  data-image-upload-target="removeButton"
                  data-action="image-upload#remove">✕ Remove photo</button>
        <% end %>
      </div>
      <%= image_tag "", alt: "Upload preview", class: "plant-graphic-preview-image", data: { image_upload_target: "preview" }, style: "display: none;" %>
      <small>PNG, JPEG, WEBP, or GIF — up to 20MB.</small>
    </div>
  </div>

  <div>
    <%= form.label :location_id, style: "display: block" %>
    <%= form.select :location_id, options_from_collection_for_select(current_project.locations, :id, :name, tank&.location&.id), prompt: '-- Select Location --' %>
  </div>

  <div>
    <%= form.label :water_change_min_days, "Water Change Min (days)", style: "display: block" %>
    <%= form.number_field :water_change_min_days, min: 1, placeholder: "e.g. 7" %>
  </div>

  <div>
    <%= form.label :water_change_max_days, "Water Change Max (days)", style: "display: block" %>
    <%= form.number_field :water_change_max_days, min: 1, placeholder: "e.g. 14" %>
  </div>

  <div>
    <%= form.submit "💾 #{tank.new_record? ? 'Create' : 'Update'} Tank", class: 'saveButton' %>
  </div>
<% end %>
