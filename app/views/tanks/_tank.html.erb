<%= link_to tank, class: "resource-card#{' with-photo' if tank.picture_attached?}" do %>
  <% if tank.picture_attached? %>
    <%= image_tag tank.picture.variant(Tank::PICTURE_THUMB_VARIANT), alt: tank.name, class: 'resource-card-photo' %>
  <% end %>
  <div class="resource-card-body">
    <div class="resource-card-name"><%= tank.name %></div>
    <div class="resource-card-meta">
      <%= tank.print_capacity %>
      <% if tank.location %> · <%= tank.location %><% end %>
    </div>
  </div>
<% end %>
