<% content_for :title, "Tank: #{@tank}" %>

<h1>
  <%= link_to t('.tanks'), tanks_path, class: 'breadcrumb' %>
  <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
  <%= @tank %>
</h1>

<div class="info-card">
  <div class="info-card-grid">
    <div class="info-card-section">
      <div class="info-row">
        <span class="label">Name</span>
        <span class="value"><%= @tank.name %></span>
      </div>
      <div class="info-row">
        <span class="label">Capacity</span>
        <span class="value"><%= @tank.print_capacity || '—' %></span>
      </div>
      <div class="info-row">
        <span class="label">Location</span>
        <span class="value"><%= @tank.location %></span>
      </div>
      <% if @tank.description.present? %>
        <div class="info-row">
          <span class="label">Description</span>
          <span class="value"><%= @tank.description %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div>
  <%= link_to "✏️ Edit this Tank", edit_tank_path(@tank), class: 'link' %>
  <%= link_to "↩️ Back to Tanks", tanks_path, class: 'link' %>
</div>

<h2>Water Parameters</h2>
<%= link_to new_tank_water_test_path(@tank), class: "link" do %>
  🧪 New Test
<% end %>
<%= render 'water_tests/water_tests', water_tests: @water_tests %>

<%= button_to "🗑️ Destroy this tank", @tank, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('Are you sure you want to permanently delete this Tank?');" %>
