<%= form_with(model: project) do |form| %>
  <% if project.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h2>

      <ul>
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, t('attributes.name'), style: "display: block" %>
    <%= form.text_field :name, autofocus: project.new_record? %>
  </div>

  <% unless project.new_record? %>
    <div>
      <%= form.label :api_key, t('attributes.api_key'), style: "display: block" %>
      <%= form.text_field :api_key %>
    </div>

    <div>
      <%= form.label :moisture_measurement_type, t('attributes.moisture_measurement_type'), style: "display: block" %>
      <%= form.select :moisture_measurement_type,
          options_for_select(
            [['Numeric', 'numeric'],
             ['Categorical (Dry/Wet/etc)', 'categorical']],
            project.moisture_measurement_type || 'numeric'
          ) %>
      <small style="display: block; margin-top: 0.25rem; color: #666;">This setting applies to all plants in this project</small>
    </div>
  <% end %>
  <br>
  <div>
    <% submit_text = t(project.new_record? ? 'projects.create_project' : 'projects.update_project') %>
    <%= form.submit submit_text, class: 'saveButton' %>
  </div>
<% end %>
