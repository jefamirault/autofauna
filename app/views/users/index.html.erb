<h1><%= t 'layouts.application.users' %></h1>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Email</th>
      <th><%= t 'attributes.projects' %></th>
      <th><%= t 'attributes.collaborations' %></th>
      <th><%= t 'attributes.login_enabled' %></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td>
          <%= user.id %>
        </td>
        <td>
          <%= user.email %>
        </td>
        <td>
          <%= user.projects.count %>
        </td>
        <td>
          <%= user.collaborations.count %>
        </td>
        <td>
          <%= button_to user.login_enabled? ? "Enabled" : "Disabled", user_path(user, user: { login_enabled: !user.login_enabled }), method: :patch, class: user.login_enabled? ? 'buttonLink' : 'buttonLinkDanger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>