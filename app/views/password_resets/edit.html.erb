<div class="settings-card auth-card">
  <h2><%= t 'welcome' %></h2>

  <%= form_with model: @user, url: password_reset_path(token: params[:token]) do |form| %>
    <% if form.object.errors.any? %>
      <div class="auth-errors">
        <% form.object.errors.full_messages.each do |message| %>
          <div><%= message %></div>
        <% end %>
      </div>
    <% end %>

    <div class="field">
      <%= form.label :password, t('account.new_password') %>
      <%= form.password_field :password, autofocus: true, placeholder: "min 6 characters" %>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, t('password_confirmation') %>
      <%= form.password_field :password_confirmation, placeholder: "min 6 characters" %>
    </div>

    <div class="submit">
      <%= form.submit t('reset_your_password'), class: 'saveButton' %>
    </div>
  <% end %>
</div>
