<div class="settings-card auth-card">
  <h1 class="auth-heading-sm"><%= t 'forgot_password_heading' %></h1>

  <%= form_with model: User.new, url: password_reset_path do |form| %>
    <div class="field">
      <%= form.label :email %>
      <%= form.email_field :email, autofocus: true, placeholder: "e.g. janedoe@gmail.com" %>
    </div>

    <div class="submit">
      <%= form.submit t('reset_password'), class: 'saveButton' %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= link_to t('log_in'), new_session_path, class: 'link' %>
    <%= link_to t('sign_up'), new_registration_path, class: 'link' %>
  </div>
</div>
