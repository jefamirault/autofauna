<% content_for :title, 'Plants' %>

<div>
  <h1 style="display:inline-block"><%= t '.plants' %></h1>
</div>

<div class="formContainer">
  <%= search_form_for @q do |f| %>
    <%= f.search_field :name_or_location_name_cont, placeholder: t('plants.index.search_plants'), autofocus: !mobile_device? %>
    <%= f.submit "&#128269;".html_safe %>
  <% end %>
</div>

<div id="search-options">

  <% if @location_filters.size > 1 %>
    <div class="display-toggle">
      <span class="display-toggle-label"><%= t('.display_by') %>:</span>
      <%= link_to t('.watering'), plants_path(display: "watering", q: params[:q]&.to_unsafe_h),
                  class: "display-toggle-btn #{'active' if @display_mode == 'watering'}" %>
      <%= link_to t('.location'), plants_path(display: "location", q: params[:q]&.to_unsafe_h),
                  class: "display-toggle-btn #{'active' if @display_mode == 'location'}" %>
    </div>
  <% end %>

  <% if @location_filters.size > 1 %>
    <div data-controller="collapsible-filters"
         data-collapsible-filters-expanded-value="false">
      <div class="location-filters"
           data-collapsible-filters-target="container">
        <span class="display-toggle-label"><%= t('.filter_by_location') %>:</span>
        <% @location_filters.each do |name, id| %>
          <% loc_key = id&.to_s || "none" %>
          <% is_active = @active_location_ids.include?(loc_key) %>
          <% if is_active %>
            <% new_locations = @active_location_ids.reject { |l| l == loc_key }.to_a %>
          <% else %>
            <% new_locations = (@active_location_ids.to_a + [loc_key]) %>
          <% end %>
          <%= link_to name,
                      plants_path(display: params[:display], q: params[:q]&.to_unsafe_h, locations: new_locations.presence),
                      class: "display-toggle-btn #{'active' if is_active}" %>
        <% end %>
      </div>
      <% if @location_filters.size > 4 %>
        <button type="button"
                class="location-filters-toggle"
                data-collapsible-filters-target="toggleButton"
                data-action="click->collapsible-filters#toggle"
                data-more-text="<%= t('.show_more') %>"
                data-less-text="<%= t('.show_less') %>">
          <%= t('.show_more') %>
        </button>
      <% end %>
    </div>
  <% end %>
</div>

<div style="padding: 0 0.75rem;"><%= "#{@plants.size} Active Plants" %>
  <%= params['q']['name_or_location_name_cont'] && params['q']['name_or_location_name_cont'] != '' ? " matching \"#{params['q']['name_or_location_name_cont']}\"" : ''%>
  <% if params['q']['name_or_location_name_cont'] && params['q']['name_or_location_name_cont'] != '' %>
    - <%= link_to t('clear_search'), plants_path %>
  <% end %>
</div>

<% if @display_mode == "location" %>
  <% @plants_by_location.each do |location_name, plants| %>
    <h3 class="location-group-header"><%= location_name %></h3>
    <div class="plant-cards">
      <% plants.each do |plant| %>
        <%= render 'plant_row', plant: plant %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <div class="plant-cards">
    <% @plants.each do |plant| %>
      <%= render 'plant_row', plant: plant %>
    <% end %>
  </div>
<% end %>

<div style=" text-align: center;">
  <div class="plantButton">
    <%= link_to "🌱 #{t '.new_plant'}", new_plant_path %>
  </div>
</div>