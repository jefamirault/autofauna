<% content_for :title, 'Plants' %>

<% content_for :header_extra do %>
  <% search_term = params.dig('q', 'name_or_location_name_cont') %>
  <div data-controller="location-filter filter-collapse"
       data-location-filter-display-mode-value="<%= @display_mode %>"
       data-location-filter-search-term-value="<%= search_term || '' %>"
       style="display: contents">
    <div class="header-top-row">
      <div id="headerSearch" data-controller="header-search">
        <%= search_form_for @q, html: { id: "plantSearchForm", data: { turbo_frame: "plants-results" } } do |f| %>
          <div class="search-input-wrapper">
            <span class="search-icon">
              <%= image_tag 'search_icon_256.png', alt: 'Search', class: 'search-icon-img' %>
            </span>
            <%= f.search_field :name_or_location_name_cont,
                placeholder: t('plants.index.search_plants'),
                autofocus: !mobile_device?,
                data: {
                  action: "input->header-search#search input->location-filter#updateSearchClearButton",
                  location_filter_target: "searchInput"
                } %>
            <button type="button"
                    class="search-clear-btn"
                    data-location-filter-target="clearSearchBtn"
                    data-action="click->location-filter#clearSearch"
                    style="display: none;">
              ✕
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <%# Collapsible search options: saved searches, filters, sort, and select %>
    <div class="header-collapse-panel" data-filter-collapse-target="filterRow">
      <div class="header-collapse-inner">

      <%# Saved Searches — live in the collapsible panel so they get its full width.
          Always rendered so Turbo Stream can append chips. %>
      <div class="saved-searches-row">
        <div id="saved-searches-list">
          <% @saved_searches.each do |ss| %>
            <%= render 'saved_searches/saved_search', saved_search: ss %>
          <% end %>
        </div>
        <%= render 'saved_searches/save_form', query_term: search_term, hidden: !search_term.present? %>
      </div>

      <% if @location_filters.size > 1 || @recipe_filters.any? %>
        <div class="filter-row-content">

          <% if @location_filters.size > 1 %>
            <div data-controller="collapsible-filters"
                 data-collapsible-filters-expanded-value="false">
              <div class="collapsible-filter">
                <div class="filter-buttons-scroll"
                     data-collapsible-filters-target="container"
                     data-location-filter-target="buttonContainer">
                  <span class="filter-section-label">📍 <span class="filter-label-text"><%= t('.location_label') %>:</span></span>
                  <% @location_filters.each do |filter| %>
                    <button type="button"
                            class="display-toggle-btn"
                            style="--filter-color: <%= filter[:color] %>;"
                            data-location-filter-target="filterButton"
                            data-location-id="<%= filter[:id]&.to_s || 'none' %>"
                            data-location-count="<%= filter[:count] %>"
                            data-location-color="<%= filter[:color] %>"
                            data-action="click->location-filter#toggleFilter">
                      <%= filter[:name] %>
                    </button>
                  <% end %>
                </div>
                <span class="filter-actions">
                  <%# Always render the toggle; collapsible-filters hides it via JS when
                      the row isn't actually overflowing (overflow can occur with fewer
                      than 5 wide buttons on narrow screens, so a fixed count gate misses it). %>
                  <button type="button"
                          class="filter-toggle-btn"
                          data-collapsible-filters-target="toggleButton"
                          data-action="click->collapsible-filters#toggle"
                          data-more-text="<%= t('.show_more') %>"
                          data-less-text="<%= t('.show_less') %>"
                          data-more-text-short="<%= t('.more') %>"
                          data-less-text-short="<%= t('.less') %>">
                    <%= t('.show_more') %>
                  </button>
                  <button type="button"
                          class="remove-filter-btn"
                          data-action="click->location-filter#clearLocationFilter">
                    ✕
                  </button>
                </span>
              </div>
            </div>
          <% end %>

          <% if @recipe_filters.any? %>
            <div data-controller="collapsible-filters"
                 data-collapsible-filters-expanded-value="false">
              <div class="collapsible-filter">
                <div class="filter-buttons-scroll"
                     data-collapsible-filters-target="container"
                     data-location-filter-target="recipeButtonContainer">
                  <span class="filter-section-label">🧪 <span class="filter-label-text"><%= t('.recipe_label') %>:</span></span>
                  <% @recipe_filters.each do |filter| %>
                    <button type="button"
                            class="display-toggle-btn"
                            style="--filter-color: <%= filter[:color] %>;"
                            data-location-filter-target="recipeFilterButton"
                            data-recipe-id="<%= filter[:id]&.to_s || 'none' %>"
                            data-recipe-count="<%= filter[:count] %>"
                            data-recipe-color="<%= filter[:color] %>"
                            data-action="click->location-filter#toggleRecipeFilter">
                      <%= filter[:name] %>
                    </button>
                  <% end %>
                </div>
                <span class="filter-actions">
                  <%# Always render the toggle; collapsible-filters hides it via JS when
                      the row isn't actually overflowing (overflow can occur with fewer
                      than 5 wide buttons on narrow screens, so a fixed count gate misses it). %>
                  <button type="button"
                          class="filter-toggle-btn"
                          data-collapsible-filters-target="toggleButton"
                          data-action="click->collapsible-filters#toggle"
                          data-more-text="<%= t('.show_more') %>"
                          data-less-text="<%= t('.show_less') %>"
                          data-more-text-short="<%= t('.more') %>"
                          data-less-text-short="<%= t('.less') %>">
                    <%= t('.show_more') %>
                  </button>
                  <button type="button"
                          class="remove-filter-btn"
                          data-action="click->location-filter#clearRecipeFilter">
                    ✕
                  </button>
                </span>
              </div>
            </div>
          <% end %>

        </div>
      <% end %>

      <%# Sort buttons + the "show watered plants" toggle on one line, below the filters.
          The toggle is linked to the search form via form="" since it's outside it. %>
      <div class="sort-toggle-row">
        <% if @location_filters.size > 1 || @recipe_filters.any? %>
          <div class="sort-row">
            <span class="row-label"><%= t('.sort') %>:</span>
            <button type="button"
                    class="display-toggle-btn <%= 'active' if @display_mode == 'watering' %>"
                    data-action="click->location-filter#switchDisplayMode"
                    data-mode="watering">
              💧 <%= t('.watering') %>
            </button>
            <% if @location_filters.size > 1 %>
              <button type="button"
                      class="display-toggle-btn <%= 'active' if @display_mode == 'location' %>"
                      data-action="click->location-filter#switchDisplayMode"
                      data-mode="location">
                📍 <%= t('.location') %>
              </button>
            <% end %>
            <% if @recipe_filters.any? %>
              <button type="button"
                      class="display-toggle-btn <%= 'active' if @display_mode == 'recipe' %>"
                      data-action="click->location-filter#switchDisplayMode"
                      data-mode="recipe">
                🧪 <%= t('.recipe') %>
              </button>
            <% end %>
          </div>
        <% end %>
        <label class="hide-scheduled-switch">
          <input type="checkbox"
                 name="hide_scheduled"
                 value="true"
                 form="plantSearchForm"
                 <%= 'checked' if @hide_scheduled %>
                 data-action="change->location-filter#toggleHideScheduled">
          <span class="hide-scheduled-label"><%= t('.hide_watered_label') %></span>
        </label>
      </div>
      </div>
    </div>

    <div class="card-fields-menu" data-controller="card-fields">
      <button type="button" class="card-fields-btn"
              data-action="click->card-fields#toggle"
              title="<%= t('.fields_menu_title') %>"
              aria-label="<%= t('.fields_menu_title') %>">⚙️</button>
      <div class="card-fields-dropdown hidden" data-card-fields-target="menu">
        <div class="card-fields-preview">
          <div class="cfp-caption">↕ <%= t('.fields_reorder_hint') %></div>
          <div class="cfp-card">
            <div class="cfp-head">
              <span class="cfp-graphic">🪴</span>
              <span class="cfp-name"><%= t('.fields_preview_name') %></span>
            </div>
            <div class="cfp-watering" data-line-class="plant-card-watering"
                 data-card-fields-target="previewLine">🕐 <%= t('.fields_preview_next') %></div>
            <div class="cfp-rows" data-card-fields-target="rows">
              <% if feature_enabled?(:precise_measurements) %>
                <div class="cfp-row" data-line-class="plant-card-last-watering-volume"
                     data-card-fields-target="previewRow"
                     data-action="pointerdown->card-fields#dragStart">
                  <span class="cfp-handle">⠿</span><span class="cfp-icon">💧</span><span class="cfp-val"><%= t('.fields_preview_volume') %></span>
                </div>
              <% end %>
              <div class="cfp-row" data-line-class="plant-card-last-watering-notes"
                   data-card-fields-target="previewRow"
                   data-action="pointerdown->card-fields#dragStart">
                <span class="cfp-handle">⠿</span><span class="cfp-icon">📝</span><span class="cfp-val"><%= t('.fields_preview_notes') %></span>
              </div>
              <div class="cfp-row" data-line-class="plant-card-last-watering-time"
                   data-card-fields-target="previewRow"
                   data-action="pointerdown->card-fields#dragStart">
                <span class="cfp-handle">⠿</span><span class="cfp-icon">⌛</span><span class="cfp-val"><%= t('.fields_preview_last') %></span>
              </div>
              <div class="cfp-row" data-line-class="plant-card-location"
                   data-card-fields-target="previewRow"
                   data-action="pointerdown->card-fields#dragStart">
                <span class="cfp-handle">⠿</span><span class="cfp-icon">📍</span><span class="cfp-val"><%= t('.fields_preview_location') %></span>
              </div>
              <div class="cfp-row" data-line-class="plant-card-container"
                   data-card-fields-target="previewRow"
                   data-action="pointerdown->card-fields#dragStart">
                <span class="cfp-handle">⠿</span><span class="cfp-icon">🫙</span><span class="cfp-val"><%= t('.fields_preview_container') %></span>
              </div>
              <% if feature_enabled?(:use_fertilizers) %>
                <div class="cfp-row" data-line-class="plant-card-recipe"
                     data-card-fields-target="previewRow"
                     data-action="pointerdown->card-fields#dragStart">
                  <span class="cfp-handle">⠿</span><span class="cfp-icon">🧪</span><span class="cfp-val"><%= t('.fields_preview_fertilizer') %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <div class="card-fields-list">
        <div class="card-fields-heading"><%= t('.fields_menu_title') %></div>
        <label>
          <span class="card-field-icon">🕐</span>
          <span class="card-field-label"><%= t('.field_next_watering') %></span>
          <input type="checkbox" data-line-class="plant-card-watering"
                 data-card-fields-target="checkbox" data-action="change->card-fields#change">
        </label>
        <% if feature_enabled?(:precise_measurements) %>
          <label>
            <span class="card-field-icon">💧</span>
            <span class="card-field-label"><%= t('.field_volume') %></span>
            <input type="checkbox" data-line-class="plant-card-last-watering-volume"
                   data-card-fields-target="checkbox" data-action="change->card-fields#change">
          </label>
        <% end %>
        <label>
          <span class="card-field-icon">📝</span>
          <span class="card-field-label"><%= t('.field_notes') %></span>
          <input type="checkbox" data-line-class="plant-card-last-watering-notes"
                 data-card-fields-target="checkbox" data-action="change->card-fields#change">
        </label>
        <label>
          <span class="card-field-icon">⌛</span>
          <span class="card-field-label"><%= t('.field_last_watered') %></span>
          <input type="checkbox" data-line-class="plant-card-last-watering-time"
                 data-card-fields-target="checkbox" data-action="change->card-fields#change">
        </label>
        <label>
          <span class="card-field-icon">📍</span>
          <span class="card-field-label"><%= t('.field_location') %></span>
          <input type="checkbox" data-line-class="plant-card-location"
                 data-card-fields-target="checkbox" data-action="change->card-fields#change">
        </label>
        <label>
          <span class="card-field-icon">🫙</span>
          <span class="card-field-label"><%= t('.field_container') %></span>
          <input type="checkbox" data-line-class="plant-card-container"
                 data-card-fields-target="checkbox" data-action="change->card-fields#change">
        </label>
        <% if feature_enabled?(:use_fertilizers) %>
          <label>
            <span class="card-field-icon">🧪</span>
            <span class="card-field-label"><%= t('.field_fertilizer') %></span>
            <input type="checkbox" data-line-class="plant-card-recipe"
                   data-card-fields-target="checkbox" data-action="change->card-fields#change">
          </label>
        <% end %>
        </div>
      </div>
    </div>
    <%# Collapse toggle — floats centered on the header's bottom edge %>
    <button type="button"
            class="filter-collapse-btn"
            data-filter-collapse-target="toggleBtn"
            data-action="click->filter-collapse#toggle"
            aria-expanded="false"
            aria-label="<%= t('.toggle_filters') %>">
      <span class="filter-collapse-icon">▲</span>
    </button>
  </div>
<% end %>

<%= turbo_frame_tag "plants-results" do %>
<div data-controller="location-filter<%= ' plant-select' if can_edit? %>"
     <% if can_edit? %>
     data-plant-select-csrf-value="<%= form_authenticity_token %>"
     data-plant-select-bulk-water-url-value="<%= bulk_water_plants_path %>"
     data-plant-select-bulk-archive-url-value="<%= bulk_archive_plants_path %>"
     data-plant-select-bulk-set-location-url-value="<%= bulk_set_location_plants_path %>"
     data-plant-select-create-group-url-value="<%= create_from_selection_plant_groups_path %>"
     data-plant-select-add-to-group-url-template-value="<%= add_plants_plant_group_path('__ID__') %>"
     data-plant-select-confirm-archive-value="<%= t('plants.bulk.confirm_archive') %>"
     <% end %>
     data-location-filter-display-mode-value="<%= @display_mode %>"
     data-location-filter-count-template-value="<%= t('.showing_count', total: '__TOTAL__') %>"
     data-location-filter-selected-template-value="<%= t('.selected_count', selected: '__SELECTED__', total: '__TOTAL__') %>"
     data-location-filter-search-term-value="<%= params.dig('q', 'name_or_location_name_cont') || '' %>"
     data-location-filter-current-page-value="1"
     data-location-filter-showing-template-value="<%= t('.showing_info', shown: '__SHOWN__', total: '__TOTAL__') %>"
     data-location-filter-clear-search-label-value="<%= t('.show_all') %>">

<% search_term = params.dig('q', 'name_or_location_name_cont') %>
<% filters_active = search_term.present? || params[:locations].present? || params[:recipes].present? || params[:hide_scheduled] == 'true' || (params[:display].present? && params[:display] != 'watering') %>
<div class="plants-toolbar">
  <div class="plants-count-headers" data-location-filter-target="resultsCount">
    <h1 data-location-filter-target="totalCount"><%= t('.showing_count', total: @plants.size) %><% if filters_active %> - <%= link_to t('.show_all'), "#", data: { action: "click->location-filter#clearSearch" } %><% end %></h1>
  </div>
  <% if can_edit? %>
    <div class="select-row">
      <button type="button"
              class="display-toggle-btn select-toggle-btn"
              data-plant-select-target="modeBtn"
              data-action="click->plant-select#toggleMode">
        ☑ <%= t('plants.bulk.select') %>
      </button>
    </div>
  <% end %>
</div>

<!-- Location Groups (always rendered, visibility controlled by JavaScript) -->
<div data-location-filter-target="locationGroupsContainer" style="display: <%= @display_mode == 'location' ? '' : 'none' %>;">
  <% @plants_by_location.each do |(location_name, location_color), plants| %>
    <div data-location-filter-target="locationGroup"
         data-location-id="<%= plants.first&.location_id&.to_s || 'none' %>"
         data-controller="collapsible-group"
         data-collapsible-group-storage-key-value="location-group-<%= plants.first&.location_id || 'none' %>">
      <h3 class="location-group-header clickable"
          style="background-color: <%= location_color %>22; border-left: 4px solid <%= location_color %>;"
          data-action="click->collapsible-group#toggle"
          data-collapsible-group-target="header">
        <span data-collapsible-group-target="icon">▼</span>
        <%= location_name %>
        <span class="group-count">(<span data-location-filter-target="groupCount"><%= plants.size %></span>)</span>
      </h3>
      <% if (loc_id = plants.first&.location_id) && can_edit? %>
        <div class="group-watering-bar">
          <%= button_to "💧 #{t('.water_all')}", water_all_location_path(loc_id),
                class: 'group-water-all-btn', form_class: 'group-water-all-form' %>
        </div>
      <% end %>
      <div class="plant-cards" data-collapsible-group-target="content">
        <% plants.each do |plant| %>
          <%= render 'plant_row', plant: plant %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Recipe Groups (always rendered, visibility controlled by JavaScript) -->
<div data-location-filter-target="recipeGroupsContainer" style="display: <%= @display_mode == 'recipe' ? '' : 'none' %>;">
  <% @plants_by_recipe.each do |(recipe_name, recipe_color), plants| %>
    <div data-location-filter-target="recipeGroup"
         data-recipe-id="<%= plants.first&.recipe_id&.to_s || 'none' %>"
         data-controller="collapsible-group"
         data-collapsible-group-storage-key-value="recipe-group-<%= plants.first&.recipe_id || 'none' %>">
      <h3 class="location-group-header clickable"
          style="background-color: <%= recipe_color %>22; border-left: 4px solid <%= recipe_color %>;"
          data-action="click->collapsible-group#toggle"
          data-collapsible-group-target="header">
        <span data-collapsible-group-target="icon">▼</span>
        <%= recipe_name %>
        <span class="group-count">(<span data-location-filter-target="groupCount"><%= plants.size %></span>)</span>
      </h3>
      <div class="plant-cards" data-collapsible-group-target="content">
        <% plants.each do |plant| %>
          <%= render 'plant_row', plant: plant %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Watering Mode (flat list, always rendered, visibility controlled by JavaScript) -->
<div data-location-filter-target="wateringGroupsContainer" style="display: <%= @display_mode == 'watering' ? '' : 'none' %>;">
  <div class="plant-cards" data-location-filter-target="wateringGroup">
    <% @plants.each do |plant| %>
      <%= render 'plant_row', plant: plant %>
    <% end %>
  </div>
</div>

<div class="pagination-controls" data-location-filter-target="paginationControls" style="display: <%= @display_mode == 'watering' ? '' : 'none' %>;">
  <div class="pagination-info" data-location-filter-target="paginationInfo"></div>
  <button type="button" class="load-more-btn" data-location-filter-target="loadMoreBtn"
          data-action="click->location-filter#loadMore" style="display: none;"><%= t('.load_more') %></button>
</div>

<div class="back-to-top" data-location-filter-target="backToTop" style="display: none;">
  <button type="button" class="back-to-top-btn"
          data-action="click->location-filter#scrollToTop">↑ <%= t('.back_to_top') %></button>
</div>

<% if can_edit? %>
  <div class="plant-select-bar" data-plant-select-target="actionBar" style="display: none;">
    <div class="plant-select-bar-row plant-select-bar-meta">
      <span class="plant-select-count" data-plant-select-target="count"
            data-template="<%= t('plants.bulk.selected', count: '__COUNT__') %>"
            data-empty="<%= t('plants.bulk.select_one') %>"><%= t('plants.bulk.selected', count: 0) %></span>
      <button type="button" class="display-toggle-btn" data-action="click->plant-select#selectAll"><%= t('plants.bulk.select_all') %></button>
      <button type="button" class="display-toggle-btn" data-action="click->plant-select#clear"><%= t('plants.bulk.clear') %></button>
    </div>
    <div class="plant-select-bar-row plant-select-bar-actions">
      <button type="button" class="display-toggle-btn plant-select-water" data-action="click->plant-select#water">💧 <%= t('plants.bulk.water') %></button>
      <button type="button" class="display-toggle-btn plant-select-options-btn" data-action="click->plant-select#toggleWaterOptions"><%= t('plants.bulk.options') %> ▾</button>
      <button type="button" class="display-toggle-btn" data-action="click->plant-select#createGroup">👪 <%= t('plants.bulk.new_group') %></button>
      <% if @all_groups.any? %>
        <select class="plant-select-dropdown" data-action="change->plant-select#addToGroup">
          <option value="" disabled selected>➕ <%= t('plants.bulk.add_to_group') %></option>
          <% @all_groups.each do |g| %>
            <option value="<%= g.id %>"><%= g.name %></option>
          <% end %>
        </select>
      <% end %>
      <select class="plant-select-dropdown" data-action="change->plant-select#setLocation">
        <option value="" disabled selected>📍 <%= t('plants.bulk.set_location') %></option>
        <% @all_locations.each do |loc| %>
          <option value="<%= loc.id %>"><%= loc.name %></option>
        <% end %>
        <option value="none"><%= t('plants.index.no_location') %></option>
      </select>
      <button type="button" class="display-toggle-btn plant-select-archive" data-action="click->plant-select#archive">🗄 <%= t('plants.bulk.archive') %></button>
    </div>

    <%# Optional watering details applied to every selected plant (blank fields carry forward). %>
    <div class="plant-select-water-options" data-plant-select-target="waterOptions" style="display: none;"
         data-controller="watering-recipe"
         data-watering-recipe-url-value="<%= for_recipe_recipe_batches_path %>">
      <% if feature_enabled?(:precise_measurements) %>
        <div class="inline-field">
          <label><%= Watering.human_attribute_name(:volume) %></label>
          <input type="number" step="any" name="watering[volume]" placeholder="e.g. 2.0" class="inline-input">
        </div>
        <div class="inline-field inline-field-units">
          <label><%= t('attributes.units') %></label>
          <select name="watering[units]" class="inline-input">
            <option value="">— <%= t('plants.bulk.keep') %> —</option>
            <% Watering.units.each_key do |unit| %>
              <option value="<%= unit %>"><%= unit %></option>
            <% end %>
          </select>
        </div>
      <% end %>
      <div class="inline-field inline-field-notes">
        <label><%= Watering.human_attribute_name(:notes) %></label>
        <input type="text" name="watering[notes]" placeholder="e.g. Tap water" class="inline-input">
      </div>
      <% show_recipes = feature_enabled?(:use_fertilizers) && current_project.recipes.any? %>
      <% if show_recipes %>
        <div class="inline-field">
          <label>Recipe</label>
          <select name="watering[recipe_id]" class="inline-input"
                  data-watering-recipe-target="recipeSelect" data-action="change->watering-recipe#recipeChanged">
            <option value="">-- None --</option>
            <% current_project.recipes.order(:name).each do |recipe| %>
              <option value="<%= recipe.id %>"><%= recipe.name %></option>
            <% end %>
          </select>
        </div>
        <div class="inline-field">
          <label>Batch</label>
          <select name="watering[recipe_batch_id]" class="inline-input"
                  data-watering-recipe-target="batchSelect" data-action="change->watering-recipe#batchChanged">
            <option value="">-- None --</option>
          </select>
        </div>
      <% end %>
      <% if feature_enabled?(:precise_measurements) %>
        <div class="inline-field inline-field-tds">
          <label>TDS</label>
          <input type="number" name="watering[tds]" placeholder="ppm" class="inline-input" data-watering-recipe-target="tdsField">
        </div>
      <% elsif show_recipes %>
        <input type="hidden" name="watering[tds]" data-watering-recipe-target="tdsField">
      <% end %>
    </div>
  </div>
<% end %>

<div style="text-align: center;">
  <div class="plantButton">
    <%= link_to "🌱 #{t '.new_plant'}", new_plant_path, data: { turbo_frame: "_top" } %>
  </div>
  <% snoozed_count = @snoozed_count || current_project.plants.where(archived: false).where("snoozed_until > ?", Time.current).count %>
  <% if snoozed_count > 0 && !@show_snoozed %>
    <div class="snoozed-toggle">
      <%= link_to "😴 Show #{snoozed_count} snoozed plant#{'s' if snoozed_count != 1}", plants_path(show_snoozed: true), data: { turbo_frame: "plants-results" }, class: "snoozed-toggle-link" %>
    </div>
  <% elsif @show_snoozed %>
    <div class="snoozed-toggle">
      <%= link_to "Hide snoozed plants", plants_path, data: { turbo_frame: "plants-results" }, class: "snoozed-toggle-link" %>
    </div>
  <% end %>
</div>
</div>
<% end %>
