<% archive ||= false %>
<% just_watered ||= nil %>
<% watered_today = just_watered || plant.date_last_watering == Time.zone.now.to_date %>
<% urgency = watered_today ? :normal : plant.watering_urgency %>
<div id="<%= dom_id plant %>" class="plant-card <%= urgency %><%= ' snoozed' if !archive && plant.snoozed? %>" data-location-id="<%= plant.location_id&.to_s || 'none' %>" data-recipe-id="<%= plant.recipe_id&.to_s || 'none' %>" data-needs-watering="<%= urgency == :needs_water %>" data-watering-status="<%= urgency == :needs_water ? 'needs_water' : 'scheduled' %>" <%= 'data-controller=inline-watering' unless archive %> <%= 'data-action="click->plant-select#cardClick"'.html_safe unless archive %>>
  <% unless archive %>
    <label class="plant-card-select" data-plant-select-target="checkboxWrap" style="display: none;">
      <input type="checkbox" value="<%= plant.id %>"
             data-plant-id="<%= plant.id %>"
             data-plant-select-target="checkbox"
             data-action="change->plant-select#toggle">
    </label>
  <% end %>
  <div class="plant-card-graphic-col">
    <%= link_to plant_path(plant.id), class: "plant-card-graphic", data: { turbo_frame: "_top" } do %>
      <%= image_tag plant.display_graphic || "plant_graphics/placeholder.png", alt: "" %>
    <% end %>
  </div>
  <div class="plant-card-body">
    <div class="plant-card-name">
      <%= link_to plant_path(plant.id), data: { turbo_frame: "_top" } do %>
        <span class="plant-card-accession">#<%= plant.uid %></span><span class="plant-card-common-name"><%= plant.name %></span>
      <% end %>
    </div>
    <div class="plant-card-details">
    <% unless archive %>
      <div class="plant-card-watering">
        <% if plant.snoozed? %>
          😴 <span>Snoozed until <%= plant.snoozed_until.strftime('%a %-m/%-d') %></span>
        <% else %>
          🕐 <span class="long-text"><%= plant.time_until_watering_text.html_safe %></span><span class="short-text"><%= plant.time_until_watering_short_text.html_safe %></span>
        <% end %>
      </div>
      <% if !plant.snoozed? && (gauge_style = watering_gauge_style(plant)) %>
        <div class="plant-card-gauge" style="<%= gauge_style %>"></div>
      <% end %>
    <% end %>
    <div class="plant-card-meta">
      <% if feature_enabled?(:precise_measurements) %>
        <div class="plant-card-last-watering-volume"><span class="mi">💧</span><span class="mv"><%= last_watering_volume_text(plant) || "–" %></span></div>
      <% end %>
      <div class="plant-card-last-watering-notes"><span class="mi">📝</span><span class="mv"><%= last_watering_notes_text(plant) || "–" %></span></div>
      <div class="plant-card-last-watering-time"><span class="mi">⌛</span><span class="mv"><span class="long-text"><%= last_watering_time_text(plant).html_safe %></span><span class="short-text"><%= last_watering_time_short_text(plant).html_safe %></span></span></div>
      <% if plant.location.present? %>
        <a href="#" class="plant-card-location"
           data-action="click->location-filter#selectSingleLocation:prevent"
           data-location-id="<%= plant.location.id %>">
          <span class="mi">📍</span><span class="mv"><%= plant.location.name %></span>
        </a>
      <% else %>
        <a href="#" class="plant-card-location"
           data-action="click->location-filter#selectSingleLocation:prevent"
           data-location-id="none">
          <span class="mi">📍</span><span class="mv">–</span>
        </a>
      <% end %>
      <span class="plant-card-container"><span class="mi">🫙</span><span class="mv"><%= plant.pot.presence || "–" %></span></span>
      <% if feature_enabled?(:use_fertilizers) && plant.recipe.present? %>
        <span class="plant-card-recipe"><span class="mi">🧪</span><span class="mv"><%= plant.recipe.name %></span></span>
      <% end %>
    </div>
    </div>
  </div>
  <% unless archive %>
    <div class="plant-card-water-wrap <%= 'is-watered' if watered_today %>">
      <% if feature_enabled?(:track_waterings) %>
        <%= link_to edit_watering_path(just_watered || plant.last_watering || plant), class: "plant-card-water-col watered", data: { turbo_frame: "_top" } do %>
          <svg class="water-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z"/>
          </svg>
          <span class="plant-card-water-helper"><%= t('plants.water_button.watered') %></span>
          <span class="plant-card-edit-watering"><%= t('plants.water_button.edit') %></span>
        <% end %>
      <% else %>
        <div class="plant-card-water-col watered">
          <svg class="water-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z"/>
          </svg>
          <span class="plant-card-water-helper"><%= t('plants.water_button.watered') %></span>
        </div>
      <% end %>
      <div class="plant-card-water-col water-icon-link <%= urgency %>">
        <%# Quick water form - one click POST %>
        <%= form_with url: waterings_path, method: :post, class: "quick-water-form", data: {
          action: "turbo:submit-start->inline-watering#submitStart turbo:submit-end->inline-watering#submitEnd"
        } do |f| %>
          <%= f.hidden_field :plant_id, name: "watering[plant_id]", value: plant.id %>
          <%= f.hidden_field :watered_at, name: "watering[watered_at]", value: Time.zone.now.strftime("%Y-%m-%dT%H:%M") %>
          <% if plant.last_watering %>
            <%= f.hidden_field :volume, name: "watering[volume]", value: plant.last_watering.volume %>
            <%= f.hidden_field :units, name: "watering[units]", value: plant.last_watering.units %>
            <%= f.hidden_field :notes, name: "watering[notes]", value: plant.last_watering.notes %>
            <%= f.hidden_field :recipe_id, name: "watering[recipe_id]", value: plant.last_watering.recipe_id %>
            <%= f.hidden_field :recipe_batch_id, name: "watering[recipe_batch_id]", value: plant.last_watering.recipe_batch_id %>
            <%= f.hidden_field :tds, name: "watering[tds]", value: plant.last_watering.tds %>
          <% end %>
          <button type="submit" class="quick-water-btn" data-inline-watering-target="quickWaterBtn">
            <svg class="water-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z"/>
            </svg>
            <span class="plant-card-water-helper desktop-only"><%= t('plants.water_button.click') %></span>
            <span class="plant-card-water-helper mobile-only"><%= t('plants.water_button.tap') %></span>
          </button>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
