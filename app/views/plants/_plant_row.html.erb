<% archive ||= false %>
<% just_watered ||= nil %>
<% watered_today = just_watered || plant.date_last_watering == Time.zone.now.to_date %>
<% urgency = watered_today ? :normal : plant.watering_urgency %>
<div id="<%= dom_id plant %>" class="plant-card <%= urgency %>" data-location-id="<%= plant.location_id&.to_s || 'none' %>" data-recipe-id="<%= plant.recipe_id&.to_s || 'none' %>" data-needs-watering="<%= [:urgent, :today].include?(urgency) %>" data-watering-status="<%= urgency == :urgent ? 'urgent' : (urgency == :today ? 'today' : 'scheduled') %>">
  <div class="plant-card-graphic-col">
    <div class="plant-card-name">
      <%= link_to plant.label, plant_path(plant.id), data: { turbo_frame: "_top" } %>
    </div>
    <%= link_to plant_path(plant.id), class: "plant-card-graphic", data: { turbo_frame: "_top" } do %>
      <%= image_tag plant.graphic.present? ? plant.graphic_path : "plant_graphics/placeholder.png", alt: "" %>
    <% end %>
  </div>
  <div class="plant-card-details">
    <% unless archive %>
      <div class="plant-card-watering">
        🕐 <span class="long-text"><%= plant.time_until_watering_text.html_safe %></span><span class="short-text"><%= plant.time_until_watering_short_text.html_safe %></span>
      </div>
    <% end %>
    <div class="plant-card-meta">
      <div class="plant-card-last-watering-volume">💧 <%= last_watering_volume_text(plant) || "–" %></div>
      <div class="plant-card-last-watering-notes">📝 <%= last_watering_notes_text(plant) || "–" %></div>
      <div class="plant-card-last-watering-time">⌛ <span class="long-text"><%= last_watering_time_text(plant).html_safe %></span><span class="short-text"><%= last_watering_time_short_text(plant).html_safe %></span></div>
      <% if plant.location.present? %>
        <a href="#" class="plant-card-location"
           data-action="click->location-filter#selectSingleLocation:prevent"
           data-location-id="<%= plant.location.id %>">
          📍 <%= plant.location.name %>
        </a>
      <% else %>
        <a href="#" class="plant-card-location"
           data-action="click->location-filter#selectSingleLocation:prevent"
           data-location-id="none">
          📍 –
        </a>
      <% end %>
      <span class="plant-card-container">🫙 <%= plant.pot.presence || "–" %></span>
      <% if plant.recipe.present? %>
        <span class="plant-card-recipe">🧪 <%= plant.recipe.name %></span>
      <% end %>
    </div>
  </div>
  <% unless archive %>
    <div class="plant-card-water-wrap <%= 'is-watered' if watered_today %>">
      <%= link_to edit_watering_path(just_watered || plant.last_watering || plant), class: "plant-card-water-col watered", data: { turbo_frame: "_top" } do %>
        <svg class="water-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z"/>
        </svg>
        <span class="plant-card-water-helper"><%= t('plants.water_button.watered') %></span>
        <span class="plant-card-edit-watering"><%= t('plants.water_button.edit') %></span>
      <% end %>
      <%= button_to plant_quick_water_path(plant), form_class: "plant-card-water-col water-icon-link #{urgency}" do %>
        <svg class="water-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z"/>
        </svg>
        <span class="plant-card-water-helper desktop-only"><%= t('plants.water_button.click') %></span>
        <span class="plant-card-water-helper mobile-only"><%= t('plants.water_button.tap') %></span>
        <span class="plant-card-watered-text"><%= t('plants.water_button.watered') %></span>
      <% end %>
    </div>
  <% end %>
</div>
