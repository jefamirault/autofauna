<% archive ||= false %>
<tr id="<%= dom_id plant %>">
  <td class="graphicColumn">
    <% if plant.graphic.present? %>
      <%= link_to plant_path(plant.id) do %>
        <%= image_tag plant.graphic_path, class: "plant-row-graphic", alt: "" %>
      <% end %>
    <% end %>
  </td>
  <td class="plantColumn" style="font-weight: 500">
    <%= link_to plant.label, plant_path(plant.id) %>
  </td>
  <% unless archive %>
    <td class="nextWateringColumn" style="font-weight: 400">
      <%= plant.time_until_watering_text %>
    </td>
  <% end %>
  <td class="lastWateringColumn">
    <%= last_watering_text(plant).html_safe %>
  </td>
  <td class="locationColumn">
    <%= plant.location %>
  </td>
  <td class="containerColumn">
    <%= plant.pot %>
  </td>
  <% unless archive %>
    <td class="actionColumn">
      <% if plant.date_last_watering == Time.zone.now.to_date %>
        <%= link_to t('plants.index.edit'), edit_watering_path(plant.waterings.last) %>
      <% elsif plant.last_watering %>
        <%= link_to 'Water', plant_water_path(plant, volume: plant.last_watering.volume, units: plant.last_watering.units, notes: plant.last_watering.notes) %>
      <% else %>
        <%= link_to t('plants.index.water'), plant_water_path(plant) %>
      <% end %>
    </td>
  <% end %>
</tr>