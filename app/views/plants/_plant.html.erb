<% just_watered ||= nil %>
<% watered_today = just_watered || @plant.date_last_watering == Time.zone.now.to_date %>
<% urgency = watered_today ? :normal : @plant.watering_urgency %>
<div id="<%= dom_id plant, :show %>" class="info-card">
  <div class="info-card-grid">
    <div class="info-card-section watering-section <%= urgency %>">
      <% if watered_today %>
        <%= link_to edit_watering_path(just_watered || @plant.last_watering),
            class: "water-icon-link watered",
            aria: { label: t('plants.water_button.edit') } do %>
          <svg class="water-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z"/>
          </svg>
          <span class="water-helper-text"><%= t('plants.water_button.watered') %></span>
          <span class="water-helper-text edit-text"><%= t('plants.water_button.edit') %></span>
        <% end %>
      <% else %>
        <%= button_to plant_quick_water_path(@plant),
            form_class: "water-icon-link #{urgency}",
            aria: { label: t('plants.plant.water_this_plant') } do %>
          <svg class="water-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z"/>
          </svg>
          <span class="water-helper-text click-text"><%= t('plants.water_button.click') %></span>
          <span class="water-helper-text tap-text"><%= t('plants.water_button.tap') %></span>
          <span class="water-helper-text watered-text"><%= t('plants.water_button.watered') %></span>
        <% end %>
      <% end %>
      <div class="watering-text">
        <div class="watering-suggestion">
          <% if watered_today %>
            🕐 <strong><%= t('plants.index.watered_today') %>!</strong>
          <% else %>
            🕐 <%= @plant.time_until_watering_text.html_safe %>
          <% end %>
        </div>
        <% if @plant.min_watering_freq.nil? %>
          <div class="watering-frequency-prompt">
            <%= link_to "⏳ Set watering frequency", edit_plant_path(@plant) %>
          </div>
        <% end %>
        <div class="watering-history">
          ⌛ <%= t('attributes.last_watered') %> <%= time_ago(@plant.date_last_watering) || t('time.never') %>
        </div>
        <div class="watering-details">
          <strong class="watering-volume">💧 <%= @plant.last_watering&.print_volume || '—' %></strong>
          <br>
          <% if @plant.last_watering&.notes.present? %>
            <span class="watering-notes-text">📝 <%= @plant.last_watering.notes %></span>
          <% end %>
          <% if @plant.last_watering&.recipe.present? %>
            <span class="watering-recipe-text">🧪 <%= @plant.last_watering.recipe.name %></span>
          <% end %>
          <% if @plant.last_watering&.recipe_batch.present? %>
            <span class="watering-batch-text">🪣 Batch: <%= @plant.last_watering.recipe_batch.to_s %></span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="info-card-section details-section" data-controller="sharing-toggle" data-sharing-toggle-plant-id-value="<%= @plant.id %>">
      <div class="info-row">
        <span class="label">📍 <%= t('attributes.location') %>:</span>
        <span class="value"><%= plant.location %></span>
      </div>
      <div class="info-row">
        <span class="label">🌎 <%= t 'attributes.zone' %>:</span>
        <span class="value"><%= plant.zone %></span>
      </div>
      <% if @plant.watering_frequency_text.present? %>
        <div class="info-row">
          <span class="label">⏳ <%= t 'attributes.frequency' %>:</span>
          <span class="value"><%= plant.watering_frequency_text %></span>
        </div>
      <% end %>
      <% if @plant.latest_moisture_reading %>
        <div class="info-row">
          <span class="label">🌱 Latest Soil Moisture:</span>
          <span class="value">
            <%= @plant.latest_moisture_value %>
            <small>(<%= time_ago_in_words(@plant.latest_moisture_reading.measured_at) %> ago)</small>
          </span>
        </div>
      <% end %>
      <% if @plant.container.present? %>
        <div class="info-row">
          <span class="label">🫙 <%= t 'attributes.container' %>:</span>
          <span class="value"><%= plant.pot %></span>
        </div>
      <% end %>
      <% if plant.recipe.present? %>
        <div class="info-row">
          <span class="label">🧪 Recipe:</span>
          <span class="value"><%= link_to plant.recipe.name, recipe_path(plant.recipe) %></span>
        </div>
      <% end %>
      <% if @plant.archived %>
        <div class="info-row archived">
          <span class="label"><%= t 'attributes.archived' %>:</span>
          <span class="value"><%= t @plant.archived %></span>
        </div>
      <% end %>

      <div class="plant-detail-actions">
        <%= link_to "✏️ #{t('plants.show.edit_this_plant')}", edit_plant_path(@plant), class: 'link' %>
        <%= link_to "📈 #{t('plants.show.export_plant')}", plant_path(@plant, format: :json), class: 'link' %>
        <% if @plant.snoozed? %>
          <span class="snooze-status">😴 Snoozed until <%= @plant.snoozed_until.strftime('%a, %b %-d') %></span>
          <%= button_to "☀️ Remove Snooze", unsnooze_plant_path(@plant), method: :delete, class: 'link buttonLink snooze-btn' %>
        <% else %>
          <div data-controller="snooze-plant" style="display: inline-flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <button type="button" class="link" data-action="click->snooze-plant#toggle" data-snooze-plant-target="toggleBtn">😴 Snooze</button>
            <div class="snooze-duration-picker" data-snooze-plant-target="picker" style="display: none;">
              <span class="snooze-label">for:</span>
              <%= button_to "1 day", snooze_plant_path(@plant), params: { days: 1 }, class: "snooze-duration-btn" %>
              <%= button_to "3 days", snooze_plant_path(@plant), params: { days: 3 }, class: "snooze-duration-btn" %>
              <%= button_to "1 week", snooze_plant_path(@plant), params: { days: 7 }, class: "snooze-duration-btn" %>
            </div>
          </div>
        <% end %>
        <% sharing_active = @plant.shared? || @plant.view_shared? %>
        <a href="#" class="link sharing-toggle<%= ' sharing-active' if sharing_active %>" data-action="click->sharing-toggle#toggle" data-sharing-toggle-target="button" style="opacity: <%= sharing_active ? '1' : '0.7' %>"><%= sharing_active ? "🔓 Sharing Enabled" : "🔒 Sharing Disabled" %></a>
      </div>

      <div class="share-cards" data-sharing-toggle-target="cards" <%= 'style="display: none;"'.html_safe unless sharing_active %>>
        <div class="settings-card notification-card share-card" data-controller="share-toggle" data-share-toggle-key-value="watering-<%= @plant.id %>">
          <div class="notification-card-header" data-action="click->share-toggle#toggle">
            <h2>💧 Watering Link</h2>
          </div>
          <div class="notification-card-body" data-share-toggle-target="body">
            <%= render "plants/share_watering_body", plant: @plant %>
          </div>
        </div>

        <div class="settings-card notification-card share-card" data-controller="share-toggle" data-share-toggle-key-value="viewing-<%= @plant.id %>">
          <div class="notification-card-header" data-action="click->share-toggle#toggle">
            <h2>👁️ Viewing Link</h2>
          </div>
          <div class="notification-card-body" data-share-toggle-target="body">
            <%= render "plants/share_viewing_body", plant: @plant %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
