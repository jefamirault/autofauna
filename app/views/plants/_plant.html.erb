<div id="<%= dom_id plant %>" class="info-card">
  <div class="info-card-grid">
    <div class="info-card-section watering-section <%= @plant.watering_urgency %>">
      <%= link_to plant_water_path(@plant,
        volume: @plant.last_watering&.volume,
        units: @plant.last_watering&.units,
        notes: @plant.last_watering&.notes,
        recipe_batch_id: @plant.last_watering&.recipe_batch_id,
        recipe_id: @plant.last_watering&.recipe_id,
        tds: @plant.last_watering&.tds),
        class: "water-icon-link #{@plant.watering_urgency}",
        aria: { label: t('plants.plant.water_this_plant') } do %>
        <svg class="water-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z"/>
        </svg>
        <span class="water-helper-text click-text"><%= t('plants.water_button.click') %></span>
        <span class="water-helper-text tap-text"><%= t('plants.water_button.tap') %></span>
      <% end %>
      <div class="watering-text">
        <div class="watering-suggestion">
          🕐 <%= @plant.time_until_watering_text.html_safe %>
        </div>
        <% if @plant.min_watering_freq.nil? %>
          <div class="watering-frequency-prompt">
            <%= link_to "⏳ Set watering frequency", edit_plant_path(@plant) %>
          </div>
        <% end %>
        <div class="watering-history">
          ⌛ <%= t('attributes.last_watered') %> <%= time_ago(@plant.date_last_watering) || t('time.never') %>
        </div>
        <div class="watering-details">
          <strong class="watering-volume">💧 <%= @plant.last_watering&.print_volume || '—' %></strong>
          <br>
          <% if @plant.last_watering&.notes.present? %>
            <span class="watering-notes-text">📝 <%= @plant.last_watering.notes %></span>
          <% end %>
          <% if @plant.last_watering&.recipe.present? %>
            <span class="watering-recipe-text">🧪 <%= @plant.last_watering.recipe.name %></span>
          <% end %>
          <% if @plant.last_watering&.recipe_batch.present? %>
            <span class="watering-batch-text">🪣 Batch: <%= @plant.last_watering.recipe_batch.to_s %></span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="info-card-section location-section">
      <div class="info-row">
        <span class="label">📍 <%= t('attributes.location') %>:</span>
        <span class="value"><%= plant.location %></span>
      </div>
      <div class="info-row">
        <span class="label">🌎 <%= t 'attributes.zone' %>:</span>
        <span class="value"><%= plant.zone %></span>
      </div>
      <% if @plant.watering_frequency_text.present? %>
        <div class="info-row">
          <span class="label">⏳ <%= t 'attributes.frequency' %>:</span>
          <span class="value"><%= plant.watering_frequency_text %></span>
        </div>
      <% end %>
      <% if @plant.latest_moisture_reading %>
        <div class="info-row">
          <span class="label">🌱 Latest Soil Moisture:</span>
          <span class="value">
            <%= @plant.latest_moisture_value %>
            <small>(<%= time_ago_in_words(@plant.latest_moisture_reading.measured_at) %> ago)</small>
          </span>
        </div>
      <% end %>
      <% if @plant.container.present? %>
        <div class="info-row">
          <span class="label">🫙 <%= t 'attributes.container' %>:</span>
          <span class="value"><%= plant.pot %></span>
        </div>
      <% end %>
      <% if plant.recipe.present? %>
        <div class="info-row">
          <span class="label">🧪 Recipe:</span>
          <span class="value"><%= link_to plant.recipe.name, recipe_path(plant.recipe) %></span>
        </div>
      <% end %>
      <% if @plant.archived %>
        <div class="info-row archived">
          <span class="label"><%= t 'attributes.archived' %>:</span>
          <span class="value"><%= t @plant.archived %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>
