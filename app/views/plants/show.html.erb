<% content_for :title do %>
  #<%= @plant.uid %> <%= @plant.name %>
<% end %>

<% if @plant&.has_graphic? %>
  <% content_for :header_extra do %>
    <% lightbox_src = @plant.custom_image_attached? ? url_for(@plant.custom_image.variant(resize_to_limit: [1600, 1600])) : nil %>
    <div class="header-plant-graphic" data-controller="image-lightbox" data-image-lightbox-src-value="<%= lightbox_src %>">
      <%= image_tag @plant.display_graphic, class: 'plant-graphic-image', role: 'button', tabindex: 0, title: 'View fullscreen', data: { action: 'click->image-lightbox#open' } %>
      <div class="header-plant-name">
        <span class="plant-number">#<%= @plant.uid %></span>
        <span class="plant-name-text"><%= @plant.name %></span>
      </div>
    </div>
  <% end %>
<% end %>

<%= render @plant %>

<div class="timeline-header">
  <h3><%= t '.timeline' %></h3>
  <div class="plant-actions">
    <%# Always shown: first detailed watering / first moisture reading enables the feature (first-use) %>
    <%= link_to "💧 #{t('.new_watering')}", plant_water_path(@plant,
      volume: @plant.last_watering&.volume,
      units: @plant.last_watering&.units,
      notes: @plant.last_watering&.notes,
      recipe_batch_id: @plant.last_watering&.recipe_batch_id,
      recipe_id: @plant.last_watering&.recipe_id,
      tds: @plant.last_watering&.tds),
      class: 'link' %>
    <%= link_to "🌱 Log Soil Moisture", new_plant_soil_moisture_reading_path(@plant), class: 'link' %>
    <%= link_to "📝 #{t('new_log_entry')}", new_plant_log_entry_path(@plant), class: 'link' %>
  </div>
</div>
<%= render partial: 'timeline', locals: { timeline: @timeline, plant: @plant } %>
<div class="plant-actions">
  <%= link_to "💧 #{t('.new_watering')}", plant_water_path(@plant,
    volume: @plant.last_watering&.volume,
    units: @plant.last_watering&.units,
    notes: @plant.last_watering&.notes,
    recipe_batch_id: @plant.last_watering&.recipe_batch_id,
    recipe_id: @plant.last_watering&.recipe_id,
    tds: @plant.last_watering&.tds),
    class: 'link' %>
  <%= link_to "📝 #{t('new_log_entry')}", new_plant_log_entry_path(@plant), class: 'link' %>
</div>
