<% content_for :title do %>
  #<%= @plant.uid %> <%= @plant.name %>
<% end %>

<h1 class="plant-header">
  <% if @plant.graphic.present? %>
    <%= link_to plants_path, class: 'plant-header-graphic-link' do %>
      <%= image_tag @plant.graphic_path, class: "plant-header-graphic", alt: "#{@plant.name}" %>
    <% end %>
  <% end %>
  <%= @plant %>
</h1>

<%= render @plant %>
<p class="plant-actions">
  <%= link_to "✏️ #{t('.edit_this_plant')}", edit_plant_path(@plant), class: 'link' %>
  <%= link_to "📈 #{t('.export_plant')}", plant_path(@plant, format: :json), class: 'link' %>
  <%= link_to "🗃️ #{t('plants.all_plants')}", plants_path, class: 'link' %>
</p>

<div class="share-section">
  <h3><%= t('plants.show.share_link') %></h3>
  <% if @plant.shared? %>
    <div class="share-link-container">
      <input type="text" class="share-link-input" value="<%= shared_plant_url(@plant.share_token) %>" readonly onclick="this.select()">
      <%= button_to "⛔ #{t('plants.show.revoke_share')}", revoke_share_plant_path(@plant), method: :delete, class: 'buttonLinkDanger danger', data: { confirm: t('plants.show.revoke_confirm') } %>
      <%= button_to "🔄 #{t('plants.show.regenerate_share')}", regenerate_share_plant_path(@plant), method: :post, class: 'buttonLinkDanger danger', data: { confirm: t('plants.show.regenerate_confirm') } %>
    </div>
  <% else %>
    <%= button_to "🔗 #{t('plants.show.create_share_link')}", create_share_plant_path(@plant), method: :post, class: 'buttonLink' %>
  <% end %>
</div>

<%= link_to "💧 #{t('.new_watering')}", plant_water_path(@plant), class: 'link' %>
<%= link_to "📝 #{t('new_log_entry')}", new_plant_log_entry_path(@plant), class: 'link' %>
<h3><%= t '.timeline' %></h3>
<%= render partial: 'timeline', locals: { timeline: @timeline, plant: @plant } %>
<%= link_to "💧 #{t('.new_watering')}", plant_water_path(@plant), class: 'link' %>
<%= link_to "📝 #{t('new_log_entry')}", new_plant_log_entry_path(@plant), class: 'link' %>
