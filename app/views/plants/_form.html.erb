<% graphic_paths = Plant.available_graphics.map { |g| [g, image_path("plant_graphics/#{g}.png")] }.to_h %>
<%= form_with(model: plant, data: {
  controller: "plant-graphic",
  plant_graphic_suggest_url_value: suggest_graphic_plants_path,
  plant_graphic_paths_value: graphic_paths.to_json,
  turbo: false
}) do |form| %>
  <% if plant.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(plant.errors.count, "error") %> prohibited this plant from being saved:</h3>
      <ul>
        <% plant.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :project_id %>

  <div class="form-section-label"><%= t('plants.form.basics') %></div>

  <div class="field">
    <%= form.label :name, "🪪 #{t('attributes.name')}" %>
    <div class="autocomplete-wrapper">
      <%= form.text_field :name, autofocus: plant.new_record?, placeholder: "e.g. Pothos", autocomplete: "off", data: {
        plant_graphic_target: "nameInput",
        action: "input->plant-graphic#nameChanged keydown->plant-graphic#nameKeydown"
      } %>
      <ul class="autocomplete-list" data-plant-graphic-target="suggestions"></ul>
    </div>
  </div>

  <% if plant.persisted? %>
    <div class="field">
      <%= form.label :uid, "🌐 #{t('plants.form.number')}" %>
      <%= form.number_field :uid %>
    </div>
  <% else %>
    <%= form.hidden_field :uid %>
  <% end %>

  <div class="field">
    <%= form.label :pot, "🫙 #{t('attributes.container')}" %>
    <%= form.text_field :pot, placeholder: "e.g. Clay pot" %>
  </div>

  <% locations = current_project.locations.order(:name) %>
  <% groups = current_project.plant_groups.order(:name) %>
  <% if locations.any? || groups.any? %>
    <div class="form-section-label"><%= t('plants.form.where') %></div>

    <% unless locations.empty? %>
      <div class="field">
        <% loc_scorer = SmartSuggestions.location_scorer(current_project) %>
        <% loc_suggestions_svc = SmartSuggestions.new(locations, scorer: loc_scorer, limit: 3) %>
        <% loc_top = loc_suggestions_svc.top %>
        <% if loc_top.any? %>
          <%= render 'shared/smart_select',
              field_name: "plant[location_id]",
              field_id: "plant_location_id",
              label: "📍 #{t('attributes.location')}",
              suggestions: loc_top,
              all_items: locations,
              selected_id: plant.location_id,
              prompt: t('plants.form.none') %>
        <% else %>
          <%= form.label :location_id, "📍 #{t('attributes.location')}" %>
          <%= form.collection_select :location_id, locations, :id, :name, include_blank: t('plants.form.none') %>
        <% end %>
      </div>
    <% end %>

    <% unless groups.empty? %>
      <div class="field">
        <label>👪 Groups</label>
        <div class="recipe-checkboxes">
          <input type="hidden" name="plant[plant_group_ids][]" value="">
          <% groups.each do |group| %>
            <label class="checkbox-label">
              <input type="checkbox" name="plant[plant_group_ids][]"
                     value="<%= group.id %>"
                     <%= 'checked' if plant.plant_group_ids.include?(group.id) %>>
              <%= group.name %>
            </label>
          <% end %>
        </div>
        <small>Group plants to water them together or share a schedule.</small>
      </div>
    <% end %>
  <% end %>

  <div class="form-section-label"><%= t('plants.form.care') %></div>

  <%= form.label :min_watering_freq, '⏳ Watering Frequency' %>
  <div class="rangeInputContainer">
    <div class="range-label">Every</div>
    <div class="range-field">
      <%= form.number_field :min_watering_freq, placeholder: "e.g. 7" %>
    </div>
    <% if plant.persisted? %>
      <div class="range-dash">-</div>
      <div class="range-field">
        <%= form.number_field :max_watering_freq %>
      </div>
    <% end %>
    <div class="range-label">days</div>
  </div>

  <% recipes = feature_enabled?(:use_fertilizers) ? current_project.recipes.order(:name) : [] %>
  <% unless recipes.empty? %>
    <div class="field">
      <label>🧪 Recipes</label>
      <div class="recipe-checkboxes">
        <% recipes.each do |recipe| %>
          <label class="checkbox-label">
            <input type="checkbox" name="plant[recipe_ids][]"
                   value="<%= recipe.id %>"
                   <%= 'checked' if plant.recipes.map(&:id).include?(recipe.id) %>>
            <%= recipe.name %>
          </label>
        <% end %>
      </div>
      <small>Select zero or more recipes. The first selected recipe is used for filtering.</small>
    </div>
  <% end %>

  <div class="form-section-label"><%= t('plants.form.photo') %></div>

  <% uploaded = @plant.custom_image_attached? %>
  <div class="plant-graphic-selector">
    <%# When "library" is active we want any existing upload removed on save; the controller flips this. %>
    <%= hidden_field_tag "plant[remove_custom_image]", uploaded ? "0" : "1", data: { plant_graphic_target: "removeFlag" } %>

    <div class="graphic-source-toggle">
      <label class="checkbox-label">
        <input type="radio" name="graphic_source" value="library" <%= 'checked' unless uploaded %>
               data-plant-graphic-target="sourceLibrary"
               data-action="change->plant-graphic#sourceChanged">
        🎨 Choose from library
      </label>
      <label class="checkbox-label">
        <input type="radio" name="graphic_source" value="upload" <%= 'checked' if uploaded %>
               data-plant-graphic-target="sourceUpload"
               data-action="change->plant-graphic#sourceChanged">
        📷 Upload your own
      </label>
    </div>

    <div class="graphic-select-container" data-plant-graphic-target="libraryPanel">
      <div>
        <%= form.select :graphic,
          [[t('plants.form.select_graphic'), ""]] + Plant.graphics_for_select,
          {},
          {
            data: {
              plant_graphic_target: "graphicSelect",
              action: "change->plant-graphic#graphicChanged"
            }
          }
        %>
      </div>
      <%= image_tag "", alt: "Plant graphic preview", class: "plant-graphic-preview-image", data: { plant_graphic_target: "preview" }, style: "display: none;" %>
    </div>

    <div class="graphic-upload-container" data-plant-graphic-target="uploadPanel">
      <% if uploaded %>
        <%= image_tag @plant.custom_image.variant(resize_to_limit: [300, 300]), alt: "Current image", class: "plant-graphic-preview-image", data: { plant_graphic_target: "currentImage" } %>
      <% end %>
      <%= form.file_field :custom_image,
        accept: "image/png,image/jpeg,image/webp,image/gif",
        class: "graphic-file-input",
        data: {
          plant_graphic_target: "fileInput",
          action: "change->plant-graphic#filePreview"
        }
      %>
      <div class="graphic-upload-buttons">
        <button type="button" class="graphic-upload-btn"
                data-action="plant-graphic#chooseFile">📁 Choose a photo</button>
        <button type="button" class="graphic-upload-btn"
                data-plant-graphic-target="cameraButton"
                data-action="plant-graphic#takePhoto">📷 Take a photo</button>
      </div>
      <%= image_tag "", alt: "Upload preview", class: "plant-graphic-preview-image", data: { plant_graphic_target: "filePreview" }, style: "display: none;" %>
      <small>PNG, JPEG, WEBP, or GIF — up to 20MB.</small>
    </div>
  </div>

  <% unless @plant.new_record? %>
    <div class="archived-checkbox">
      <%= form.label :archived, "🗄️ Archived?" %>
      <%= form.check_box :archived %>
    </div>
  <% end %>
  <div class="submit">
    <% submit_text = t(plant.new_record? ? 'plants.create_plant' : 'plants.update_plant') %>
    <%= form.submit submit_text, class: 'saveButton' %>
  </div>
<% end %>
