<% content_for :title do %>
  Edit #<%= @plant.uid %> <%= @plant.name %>
<% end %>

<h1>
  <%= link_to t('.plants'), plants_path, class: 'breadcrumb' %>
  <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
  <%= link_to @plant, plant_path(@plant), class: 'breadcrumb' %>
  <%= icon 'chevron-right', variant: 'mini', class: 'breadcrumb' %>
  Edit
</h1>

<%= render "form", plant: @plant %>

<p>
  <%= link_to t('actions.discard_changes'), @plant %>
</p>
<br>
<p>
  <%= button_to t('plants.show.delete_plant'), @plant, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('#{t 'plants.messages.confirm_delete'}');" %>
</p>
