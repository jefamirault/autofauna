<% content_for :title do %>
  Edit #<%= @plant.uid %> <%= @plant.name %>
<% end %>

<% if @plant&.has_graphic? %>
  <% content_for :header_extra do %>
    <div class="header-plant-graphic">
      <%= image_tag @plant.display_graphic, class: 'plant-graphic-image' %>
      <div class="header-plant-name">
        <span class="plant-number">#<%= @plant.uid %></span>
        <span class="plant-name-text"><%= @plant.name %></span>
      </div>
    </div>
  <% end %>
<% end %>

<div class="settings-card">
  <div class="card-title-row">
    <h2><%= t('plants.edit_plant') %></h2>
    <div class="plantButton"><%= link_to @plant %></div>
  </div>
  <%= render "form", plant: @plant %>

  <div class="card-footer-actions">
    <%= link_to "❌ #{t('actions.discard_changes')}", @plant, class: 'link' %>
    <%= button_to "🗑️ #{t('plants.show.delete_plant')}", @plant, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('#{t 'plants.messages.confirm_delete'}');" %>
  </div>
</div>