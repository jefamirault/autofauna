<% content_for :title do %>
  Edit #<%= @plant.uid %> <%= @plant.name %>
<% end %>
<div class="settings-card">
  <% if @plant&.graphic_path %>
    <div class="plant-graphic-banner">
      <%= image_tag @plant.graphic_path, class: 'plant-graphic-image' %>
    </div>
  <% end %>

  <%= render "form", plant: @plant %>

  <p>
    <%= link_to "❌ #{t('actions.discard_changes')}", @plant, class: 'link' %>
  </p>
  <p>
    <%= button_to "🗑️ #{t('plants.show.delete_plant')}", @plant, method: :delete, class: 'buttonLinkDanger', onclick: "return confirm('#{t 'plants.messages.confirm_delete'}');" %>
  </p>
</div>