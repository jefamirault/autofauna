<div id="share-viewing-body-<%= plant.id %>">
  <% if plant.view_shared? %>
    <div class="share-link-container">
      <input type="text" class="share-link-input" value="<%= shared_plant_url(plant.view_share_token) %>" readonly onclick="this.select()">
      <%= button_to t('plants.show.revoke_share'), revoke_view_share_plant_path(plant), method: :delete, class: 'buttonLinkDanger danger', data: { confirm: "Revoke this viewing link?" } %>
      <%= button_to t('plants.show.regenerate_share'), regenerate_view_share_plant_path(plant), method: :post, class: 'buttonLinkDanger danger', data: { confirm: "Regenerate this viewing link? The old link will stop working." } %>
    </div>
  <% else %>
    <%= button_to "🔗 Create Viewing Link", create_view_share_plant_path(plant), method: :post, class: 'buttonLink' %>
  <% end %>
</div>
