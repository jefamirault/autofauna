<div class="settings-card auth-card">
  <h2><%= t 'sign_up' %></h2>

  <%= form_with model: @user, url: registrations_path do |form| %>
    <% if form.object.errors.any? %>
      <div class="auth-errors">
        <% form.object.errors.full_messages.each do |message| %>
          <div><%= message %></div>
        <% end %>
      </div>
    <% end %>

    <div class="field">
      <%= form.label :email, t('email') %>
      <%= form.email_field :email, autofocus: true %>
    </div>

    <div class="field">
      <%= form.label :password, t('password') %>
      <%= form.password_field :password %>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, t('password_confirmation') %>
      <%= form.password_field :password_confirmation %>
    </div>

    <div class="submit">
      <%= form.submit t('sign_up'), class: 'saveButton' %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= link_to t('log_in'), new_session_path, class: 'link' %>
    <%= link_to t('forgot_password'), new_password_reset_path, class: 'link' %>
  </div>
</div>
