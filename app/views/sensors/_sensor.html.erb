<%= link_to sensor, class: 'resource-card' do %>
  <div class="resource-card-name"><%= sensor.name %></div>
  <div class="resource-card-meta">
    <%= sensor.zone %>
    <% if sensor.hygro_sensor_readings.any? %>
      · <%= sensor.last_temp %>&deg;F · <%= sensor.last_humidity %>% RH
    <% end %>
  </div>
<% end %>
