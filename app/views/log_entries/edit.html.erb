<% content_for :title, "Edit Log Entry #{@log_entry.loggable}" %>

<div class="settings-card">
  <div class="card-title-row">
    <h2><%= t 'log_entries.edit' %></h2>
    <div class="plantButton"><%= link_to @log_entry.loggable %></div>
  </div>

  <%= render partial: "log_entries/form", locals: { log_entry: @log_entry } %>

  <div class="card-footer-actions">
    <%= link_to "❌ #{t('actions.cancel')}", plant_path(id: params[:plant_id]), class: 'link' %>
  </div>
</div>
