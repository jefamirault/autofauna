#!/bin/bash
# Launches a sprint: fetches GitHub milestone issues, groups them into worker
# categories, sets up tmux panes with worktrees, and starts claude in each.
#
# Usage: ./claude-sprint <milestone> [--agents N] [--dry-run]
#        ./claude-sprint --cleanup [<milestone>]
#
# Layout: 1 manager (top, full width) + N worker agents (bottom, split) on feature branches.
# The manager agent coordinates work; workers implement assigned issues.

set -euo pipefail

REPO_DIR="$HOME/autofauna"
REPO="jefamirault/autofauna"
SESSION="claude-sprint"
NUM_WORKERS=4
DRY_RUN=false
CLEANUP=false
MILESTONE=""

# --- Argument parsing ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    --agents)  NUM_WORKERS="$2"; shift 2 ;;
    --dry-run) DRY_RUN=true; shift ;;
    --cleanup) CLEANUP=true; shift ;;
    --help|-h)
      echo "Usage: ./claude-sprint <milestone> [--agents N] [--dry-run]"
      echo "       ./claude-sprint --cleanup [<milestone>]"
      echo ""
      echo "  <milestone>   GitHub milestone title (required for launch, optional for cleanup)"
      echo "  --agents N    Number of worker agents (default: 4)"
      echo "  --dry-run     Show plan without launching tmux/claude"
      echo "  --cleanup     Remove worktrees, branches, and databases from a sprint"
      exit 0
      ;;
    *)
      if [ -z "$MILESTONE" ]; then
        MILESTONE="$1"
      else
        echo "Unknown argument: $1"
        exit 1
      fi
      shift
      ;;
  esac
done

# --- Cleanup mode ---
if [ "$CLEANUP" = true ]; then
  echo "=== Sprint Cleanup ==="

  # Read DB credentials from .env (strip \r from Windows line endings)
  source_user=$(grep -oP '^DATABASE_USER=\K.*' "$REPO_DIR/.env" 2>/dev/null | tr -d '\r' || echo "autofauna_development")

  # Find all sprint worktrees
  worktrees=$(git -C "$REPO_DIR" worktree list --porcelain | grep -oP "^worktree \K.*sprint.*" || true)

  if [ -n "$MILESTONE" ]; then
    safe_milestone=$(echo "$MILESTONE" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//')
    worktrees=$(echo "$worktrees" | grep "$safe_milestone" || true)
  fi

  if [ -z "$worktrees" ]; then
    echo "No sprint worktrees found."
  else
    echo "Removing worktrees..."
    while IFS= read -r wt; do
      [ -z "$wt" ] && continue
      echo "  Removing worktree: $wt"
      git -C "$REPO_DIR" worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
    done <<< "$worktrees"
  fi

  # Remove sprint branches
  branches=$(git -C "$REPO_DIR" branch --list 'sprint/*' | sed 's/^[* ]*//')
  if [ -n "$MILESTONE" ]; then
    branches=$(echo "$branches" | grep "$safe_milestone" || true)
  fi

  if [ -n "$branches" ]; then
    echo "Removing branches..."
    while IFS= read -r branch; do
      [ -z "$branch" ] && continue
      echo "  Deleting branch: $branch"
      git -C "$REPO_DIR" branch -D "$branch" 2>/dev/null || true
    done <<< "$branches"
  fi

  # Drop sprint databases
  sprint_dbs=$(psql -U "$source_user" -lqt 2>/dev/null | cut -d \| -f 1 | grep -w 'autofauna_sprint_worker_[0-9]*' || true)
  if [ -n "$sprint_dbs" ]; then
    echo "Dropping databases..."
    while IFS= read -r db; do
      db=$(echo "$db" | xargs)  # trim whitespace
      [ -z "$db" ] && continue
      echo "  Dropping database: $db"
      dropdb -U "$source_user" "$db" 2>/dev/null || echo "    WARNING: Failed to drop $db"
    done <<< "$sprint_dbs"
  fi

  # Kill tmux session
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Killing tmux session '$SESSION'..."
    tmux kill-session -t "$SESSION"
  fi

  # Clean up temp files
  rm -f /tmp/claude-sprint-manager.* /tmp/claude-sprint-worker-*

  # Prune worktree references
  git -C "$REPO_DIR" worktree prune

  echo "Cleanup complete."
  exit 0
fi

if [ -z "$MILESTONE" ]; then
  echo "Usage: ./claude-sprint <milestone> [--agents N] [--dry-run]"
  exit 1
fi

# --- Detect main branch ---
main_branch=$(git -C "$REPO_DIR" symbolic-ref --short HEAD 2>/dev/null || echo "main")

# --- Fetch milestone issues ---
echo "Fetching issues for milestone '$MILESTONE'..."

issues_json=$(gh issue list \
  --repo "$REPO" \
  --milestone "$MILESTONE" \
  --state open \
  --limit 100 \
  --json number,title,labels,body)

issue_count=$(echo "$issues_json" | jq 'length')

if [ "$issue_count" -eq 0 ]; then
  echo "No open issues found for milestone '$MILESTONE'."
  exit 1
fi

echo "Found $issue_count issues."

# --- Extract unique labels (excluding milestone-level labels) ---
all_labels=$(echo "$issues_json" | jq -r '.[].labels[].name' | sort -u)
label_count=$(echo "$all_labels" | grep -c . || true)

echo "Labels: $all_labels"
echo ""

# --- Group issues into worker buckets ---
# Strategy: group by label. If more labels than workers, merge smallest groups.
# If fewer labels, split largest group or assign round-robin for unlabeled.

declare -A label_issues  # label -> comma-separated issue numbers
declare -a unlabeled_issues=()

# Assign each issue to its first label (or unlabeled)
for i in $(seq 0 $((issue_count - 1))); do
  issue_num=$(echo "$issues_json" | jq -r ".[$i].number")
  issue_title=$(echo "$issues_json" | jq -r ".[$i].title")
  first_label=$(echo "$issues_json" | jq -r ".[$i].labels[0].name // empty")

  if [ -z "$first_label" ]; then
    unlabeled_issues+=("$issue_num")
  else
    if [ -z "${label_issues[$first_label]:-}" ]; then
      label_issues[$first_label]="$issue_num"
    else
      label_issues[$first_label]="${label_issues[$first_label]},$issue_num"
    fi
  fi
done

# Build worker assignments: array of "label:issue1,issue2,..."
declare -a worker_assignments=()
declare -a worker_labels=()

while IFS= read -r label; do
  [ -z "$label" ] && continue
  if [ ${#worker_assignments[@]} -lt "$NUM_WORKERS" ]; then
    worker_assignments+=("${label_issues[$label]}")
    worker_labels+=("$label")
  else
    # Overflow: merge into existing workers round-robin
    overflow_idx=$(( ${#worker_assignments[@]} % NUM_WORKERS ))
    worker_assignments[$overflow_idx]="${worker_assignments[$overflow_idx]},${label_issues[$label]}"
    worker_labels[$overflow_idx]="${worker_labels[$overflow_idx]}+${label}"
  fi
done <<< "$all_labels"

# Distribute unlabeled issues round-robin
worker_idx=0
for issue_num in "${unlabeled_issues[@]}"; do
  if [ ${#worker_assignments[@]} -le $worker_idx ]; then
    worker_assignments+=("$issue_num")
    worker_labels+=("unlabeled")
  else
    worker_assignments[$worker_idx]="${worker_assignments[$worker_idx]},$issue_num"
  fi
  worker_idx=$(( (worker_idx + 1) % NUM_WORKERS ))
done

# Cap NUM_WORKERS to actual number of workers with issues (no empty panes)
actual_workers=${#worker_assignments[@]}
if [ "$actual_workers" -lt "$NUM_WORKERS" ]; then
  NUM_WORKERS=$actual_workers
fi

# --- Create branch names and print plan ---
declare -a branch_names=()
# Sanitize milestone for branch names
safe_milestone=$(echo "$MILESTONE" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//')

for i in $(seq 0 $((NUM_WORKERS - 1))); do
  label_slug=$(echo "${worker_labels[$i]}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9+]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//')
  branch_names+=("sprint/${safe_milestone}/${label_slug}")
done

echo "=== Sprint Plan ==="
echo "Milestone:  $MILESTONE"
echo "Manager:    $main_branch (coordinator)"
echo "Workers:    $NUM_WORKERS"
echo ""

for i in $(seq 0 $((NUM_WORKERS - 1))); do
  issues="${worker_assignments[$i]}"
  # Get titles for display
  issue_list=""
  IFS=',' read -ra nums <<< "$issues"
  for num in "${nums[@]}"; do
    title=$(echo "$issues_json" | jq -r ".[] | select(.number == $num) | .title")
    issue_list+="    #$num $title"$'\n'
  done
  echo "Worker $((i+1)):   ${branch_names[$i]}"
  echo "$issue_list"
done

if [ "$DRY_RUN" = true ]; then
  echo "(dry run — not launching)"
  exit 0
fi

# --- Read DB credentials from main .env ---
if [ ! -f "$REPO_DIR/.env" ]; then
  echo "ERROR: $REPO_DIR/.env not found. Cannot configure worker databases."
  exit 1
fi

source_user=$(grep -oP '^DATABASE_USER=\K.*' "$REPO_DIR/.env" | tr -d '\r' || echo "autofauna_development")
source_pass=$(grep -oP '^DATABASE_PASSWORD=\K.*' "$REPO_DIR/.env" | tr -d '\r' || echo "")
source_db="autofauna_development"

# --- Create branches, worktrees, databases, and .env files ---
declare -a worker_dirs=()
declare -a worker_ports=()
BASE_PORT=3001

for i in $(seq 0 $((NUM_WORKERS - 1))); do
  branch="${branch_names[$i]}"
  worktree_dir="$REPO_DIR-$(echo "$branch" | tr '/' '-')"
  worker_port=$((BASE_PORT + i))
  worker_db="autofauna_sprint_worker_$((i + 1))"

  # Create branch if it doesn't exist
  if ! git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
    echo "Creating branch '$branch'..."
    git -C "$REPO_DIR" branch "$branch" "$main_branch"
  fi

  # Create worktree if it doesn't exist
  if [ ! -d "$worktree_dir" ]; then
    echo "Creating worktree at $worktree_dir..."
    git -C "$REPO_DIR" worktree add "$worktree_dir" "$branch"
  fi

  # Write .env for this worker
  cat > "$worktree_dir/.env" <<ENVFILE
DATABASE=${worker_db}
DATABASE_USER=${source_user}
DATABASE_PASSWORD=${source_pass}
PORT=${worker_port}
ENVFILE
  echo "Created .env for worker $((i + 1)): db=${worker_db}, port=${worker_port}"

  # Create the worker database (drop + recreate to get a fresh copy each time)
  if psql -U "$source_user" -lqt 2>/dev/null | cut -d \| -f 1 | grep -qw "$worker_db"; then
    echo "Dropping existing database ${worker_db}..."
    dropdb -U "$source_user" "$worker_db"
  fi

  echo "Creating database ${worker_db}..."
  if ! createdb -U "$source_user" "$worker_db"; then
    echo "ERROR: Failed to create database ${worker_db}."
    echo "Check that PostgreSQL is running and user '$source_user' has createdb privileges."
    exit 1
  fi

  echo "Copying dev database to ${worker_db}..."
  if ! pg_dump -U "$source_user" "$source_db" | psql -U "$source_user" -d "$worker_db" -q; then
    echo "ERROR: Failed to copy database from ${source_db} to ${worker_db}."
    exit 1
  fi

  echo "Database ${worker_db} ready."

  worker_dirs+=("$worktree_dir")
  worker_ports+=("$worker_port")
done

# --- Build prompts ---

# Manager prompt
manager_issues_summary=""
for i in $(seq 0 $((NUM_WORKERS - 1))); do
  issues="${worker_assignments[$i]}"
  if [ -n "$issues" ]; then
    manager_issues_summary+="Worker $((i+1)) (branch: ${branch_names[$i]}): issues $issues"$'\n'
  fi
done

manager_prompt=$(cat <<PROMPT
You are the Sprint Manager for milestone "$MILESTONE" in the $REPO repository.

## Your Role
You coordinate $NUM_WORKERS worker agents, each running in a separate git worktree on its own branch. Your job is to:

1. **Review the milestone issues** and ensure workers have clear, non-overlapping scopes
2. **Monitor progress** by checking worker branches for commits
3. **Resolve conflicts** if workers need to touch shared files
4. **Create PRs** when workers complete their tasks
5. **Merge completed work** back to $main_branch

## Worker Assignments
$manager_issues_summary

## Workflow
1. Start by reading all milestone issues: \`gh issue list --repo $REPO --milestone "$MILESTONE" --state open --json number,title,body,labels\`
2. For each worker, create a detailed comment on their assigned issues with implementation guidance
3. Periodically check worker progress: \`git log --oneline <branch> ^$main_branch\` for each worker branch
4. When a worker's branch looks complete, review their changes: \`git diff $main_branch...<branch>\`
5. Create PRs for completed branches: \`gh pr create --base $main_branch --head <branch>\`
6. After all PRs are merged, close the milestone

## Important
- You are on the $main_branch — do NOT commit implementation code here
- Use \`gh\` commands to communicate with workers via issue comments
- If a worker needs to modify a file another worker owns, coordinate via issue comments first
- Keep the agent_log.md updated with sprint progress
PROMPT
)

# --- Launch tmux session ---
tmux kill-session -t "$SESSION" 2>/dev/null || true

# Create session with manager pane (top, full width)
tmux new-session -s "$SESSION" -d -x 200 -y 50
tmux send-keys -t "$SESSION" "cd $REPO_DIR" C-m

# Split vertically: manager on top, first worker on bottom
tmux split-window -v -t "$SESSION:0.0"
tmux send-keys -t "$SESSION:0.1" "cd ${worker_dirs[0]}" C-m

# Split the bottom area horizontally for additional workers
for i in $(seq 1 $((NUM_WORKERS - 1))); do
  tmux split-window -h -t "$SESSION:0.$i"
  tmux send-keys -t "$SESSION:0.$((i + 1))" "cd ${worker_dirs[$i]}" C-m
done

# Even out the bottom worker panes
if [ "$NUM_WORKERS" -gt 1 ]; then
  # Select all bottom panes and re-tile just the bottom row
  # Use select-layout to balance the panes while preserving top/bottom split
  tmux select-layout -t "$SESSION" main-horizontal
fi

# --- Launch claude in each pane ---
# Launch claude in manager pane (pane 0)
manager_prompt_file=$(mktemp /tmp/claude-sprint-manager.XXXXXX)
echo "$manager_prompt" > "$manager_prompt_file"
tmux send-keys -t "$SESSION:0.0" "claude --append-system-prompt \"\$(cat $manager_prompt_file)\"" C-m

# Launch claude in worker panes
for i in $(seq 0 $((NUM_WORKERS - 1))); do
  issues="${worker_assignments[$i]}"

  # Build issue details for worker prompt
  issue_details=""
  IFS=',' read -ra nums <<< "$issues"
  for num in "${nums[@]}"; do
    title=$(echo "$issues_json" | jq -r ".[] | select(.number == $num) | .title")
    body=$(echo "$issues_json" | jq -r ".[] | select(.number == $num) | .body")
    labels=$(echo "$issues_json" | jq -r ".[] | select(.number == $num) | [.labels[].name] | join(\", \")")
    issue_details+="### Issue #$num: $title"$'\n'
    issue_details+="Labels: $labels"$'\n'
    issue_details+="$body"$'\n\n'
  done

  worker_prompt=$(cat <<PROMPT
You are Worker $((i+1)) in a sprint for milestone "$MILESTONE".

## Your Scope
You are on branch \`${branch_names[$i]}\` in a git worktree. Implement the following issues:

$issue_details

## Environment
- **Database:** \`autofauna_sprint_worker_$((i+1))\` (separate from main dev DB)
- **Dev server port:** \`${worker_ports[$i]}\` (run with \`bin/rails server -p ${worker_ports[$i]}\`)
- **.env** is pre-configured in your worktree with the correct DATABASE and PORT

## Rules
1. **Stay in scope** — only modify files relevant to your assigned issues
2. **Commit frequently** with descriptive messages referencing issue numbers (e.g., "Fix #123: add validation")
3. **Do not modify** files outside your scope without coordinating (check issue comments for guidance from the manager)
4. **Read CLAUDE.md** for project conventions before starting
5. **Run tests** after each significant change
6. When done with all issues, commit your work and notify by commenting on the issues: \`gh issue comment <number> --repo $REPO --body "Implementation complete on branch ${branch_names[$i]}"\`

## Getting Started
1. Read CLAUDE.md for project conventions
2. Review each issue carefully
3. Plan your implementation approach
4. Implement one issue at a time, committing after each
5. Run tests to verify nothing is broken
PROMPT
)

  worker_prompt_file=$(mktemp /tmp/claude-sprint-worker-$((i+1)).XXXXXX)
  echo "$worker_prompt" > "$worker_prompt_file"

  pane_idx=$((i + 1))
  tmux send-keys -t "$SESSION:0.$pane_idx" "claude --append-system-prompt \"\$(cat $worker_prompt_file)\"" C-m
done

# --- Wait for claude to start, then send kickoff messages ---
echo "Waiting for Claude to initialize in each pane..."
sleep 5

# Kickoff manager
tmux send-keys -t "$SESSION:0.0" "Begin the sprint. Read the milestone issues, review the worker assignments, and post implementation guidance as comments on each issue. Then monitor worker progress periodically." Enter

# Kickoff workers
for i in $(seq 0 $((NUM_WORKERS - 1))); do
  pane_idx=$((i + 1))
  tmux send-keys -t "$SESSION:0.$pane_idx" "Begin. Read CLAUDE.md, then implement your assigned issues. Start now." Enter
done

echo ""
echo "Sprint launched: 1 manager + $NUM_WORKERS workers ($((NUM_WORKERS + 1)) panes total)"
echo "Attach with: tmux attach -t $SESSION"
echo "Cleanup with: ./claude-sprint --cleanup${MILESTONE:+ $MILESTONE}"
echo ""

tmux attach -t "$SESSION"
